<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sensorstorm</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
		<string>fr</string>
		<string>it</string>
		<string>es</string>
		<string>nl</string>
		<string>pt-BR</string>
		<string>ja</string>
		<string>ko</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Sensorstorm liest während einer Aufnahme deine Herzfrequenz, um sie zusammen mit den übrigen Sensordaten aufzuzeichnen. Es wird nichts in „Health" geschrieben.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Sensorstorm schreibt nichts in „Health". Die Herzfrequenz wird nur gelesen und zusammen mit den übrigen Sensordaten in der Aufnahme abgelegt.</string>
	<key>NSMotionUsageDescription</key>
	<string>Sensorstorm zeichnet die Bewegung deines Handgelenks auf und überträgt sie an das iPhone.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>ch.sensorstorm.app</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
</dict>
</plist>
