    "Auf diesem Gerät gibt es keine Gesundheitsdaten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no health data on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de données de santé sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo non ci sono dati sulla salute."
