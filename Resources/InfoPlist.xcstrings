    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل Sensorstorm الموقع والارتفاع والسرعة والاتجاه، ويحاذي بيانات الاتجاه إلى الشمال، ويثبّت أين سُجِّلت ملاحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm zaznamenává polohu, výšku, rychlost a kurz, srovnává data orientace na sever a podrží, kde bylo pozorování zaznamenáno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registrerer position, højde, hastighed og kurs, retter orienteringsdataene ind mod nord og noterer, hvor en observation blev registreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm zeichnet Position, Höhe, Geschwindigkeit und Kurs auf, richtet die Orientierungsdaten an Nord aus und hält fest, wo eine Beobachtung erfasst wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sensorstorm καταγράφει θέση, υψόμετρο, ταχύτητα και πορεία, ευθυγραμμίζει τα δεδομένα προσανατολισμού προς τον βορρά και κρατά πού καταγράφηκε μια παρατήρηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm records position, altitude, speed and course, references the orientation data to true north, and records where an observation was captured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registra posición, altitud, velocidad y rumbo, referencia los datos de orientación al norte geográfico y anota dónde se registró una observación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm tallentaa sijainnin, korkeuden, nopeuden ja suunnan, kohdistaa asentodatan pohjoiseen ja pitää kirjaa siitä, missä havainto kirjattiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm enregistre la position, l'altitude, la vitesse et le cap, référence les données d'orientation au nord géographique et note où une observation a été saisie."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm bilježi položaj, visinu, brzinu i smjer, poravnava podatke orijentacije prema sjeveru i pamti gdje je opažanje zabilježeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sensorstorm rögzíti a helyzetet, a magasságot, a sebességet és az irányt, északhoz igazítja a tájolási adatokat, és megjegyzi, hol rögzítettek egy észlelést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registra posizione, quota, velocità e rotta, riferisce i dati di orientamento al nord geografico e annota dove è stata registrata un'osservazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm は位置、高度、速度、進路を記録し、方位データを真北に基準づけ、観測点を記録した場所を保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm은 위치, 고도, 속도, 진행 방향을 기록하고 방위 데이터를 진북에 맞추며, 관측을 기록한 위치를 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registrerer posisjon, høyde, hastighet og kurs, retter orienteringsdataene mot nord og holder styr på hvor en observasjon ble registrert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registreert positie, hoogte, snelheid en koers, richt de oriëntatiegegevens op het ware noorden en legt vast waar een waarneming is gedaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm zapisuje pozycję, wysokość, prędkość i kurs, ustawia dane orientacji na północ i zapamiętuje, gdzie zapisano obserwację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm registra posição, altitude, velocidade e rumo, referencia os dados de orientação ao norte verdadeiro e anota onde uma observação foi registrada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm regista posição, altitude, velocidade e rumo, alinha os dados de orientação com o norte e retém onde uma observação foi registada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm înregistrează poziția, altitudinea, viteza și cursul, aliniază datele de orientare la nord și reține unde a fost înregistrată o observație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm записывает позицию, высоту, скорость и курс, выравнивает данные ориентации по северу и запоминает, где было записано наблюдение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm zaznamenáva polohu, výšku, rýchlosť a kurz, zosúlaďuje dáta orientácie na sever a podrží, kde bolo pozorovanie zaznamenané."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registrerar position, höjd, hastighet och kurs, riktar in orienteringsdatan mot norr och håller reda på var en observation registrerades."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm konumu, yüksekliği, hızı ve rotayı kaydeder, yönelim verilerini kuzeye hizalar ve bir gözlemin nerede alındığını tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm записує позицію, висоту, швидкість і курс, вирівнює дані орієнтації на північ і запам’ятовує, де було записано спостереження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 会记录位置、高度、速度和航向，把姿态数据对齐到北向，并记下观测点是在哪里采集的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 會記錄位置、高度、速度與航向，將方位資料對準真北，並記下觀測點的採集位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس Sensorstorm مستوى الصوت، ويسجّل الصوت مع القياس عند الطلب، ويسجّل صوت المقاطع القصيرة لملاحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm měří hlasitost, na přání nahrává zvuk k měření a nahrává zvuk krátkých klipů k pozorování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm måler lydstyrken, optager efter ønske lyd til målingen og optager lyden i de korte klip til en observation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm misst die Lautstärke, nimmt auf Wunsch Ton zur Messung auf und zeichnet den Ton der kurzen Clips zu einer Beobachtung auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sensorstorm μετράει την ένταση, καταγράφει κατ' επιλογή ήχο για τη μέτρηση και καταγράφει τον ήχο των σύντομων κλιπ μιας παρατήρησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm measures loudness, optionally records audio alongside a measurement, and records the audio of the short clips belonging to an observation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm mide el nivel sonoro, si lo deseas graba audio junto a una medición y graba el audio de los clips breves de una observación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm mittaa äänenvoimakkuuden, tallentaa haluttaessa äänen mittaukseen ja tallentaa havainnon lyhyiden klippien äänen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm mesure le niveau sonore, enregistre au besoin le son avec une mesure, et enregistre le son des courts clips associés à une observation."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm mjeri glasnoću, po želji snima zvuk uz mjerenje i snima zvuk kratkih isječaka uz opažanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sensorstorm méri a hangerőt, kérésre hangot vesz fel a méréshez, és rögzíti az észleléshez tartozó rövid klipek hangját."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm misura il livello sonoro, se richiesto registra l'audio insieme a una misurazione e registra l'audio dei brevi clip di un'osservazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm は音量を測定し、必要に応じて計測とともに音声を記録し、観測点に属する短いクリップの音声を記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm은 음량을 측정하고, 필요에 따라 측정과 함께 오디오를 기록하며, 관측에 속한 짧은 클립의 소리를 기록합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm måler lydstyrken, tar ved behov opp lyd til målingen og tar opp lyden i de korte klippene til en observasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm meet het geluidsniveau, neemt desgewenst audio op bij een meting en neemt het geluid op van de korte clips bij een waarneming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm mierzy głośność, na życzenie nagrywa dźwięk do pomiaru i nagrywa dźwięk krótkich klipów do obserwacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm mede o nível sonoro, opcionalmente grava áudio junto a uma medição e grava o áudio dos clipes curtos de uma observação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm mede o volume, grava som para a medição se quiseres e regista o som dos clipes curtos de uma observação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm măsoară volumul, înregistrează la cerere sunet pentru măsurătoare și înregistrează sunetul clipurilor scurte pentru o observație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm измеряет громкость, по желанию записывает звук к измерению и записывает звук коротких клипов к наблюдению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm meria hlasitosť, na želanie nahráva zvuk k meraniu a nahráva zvuk krátkych klipov k pozorovaniu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm mäter ljudstyrkan, spelar vid behov in ljud till mätningen och spelar in ljudet i de korta klippen till en observation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm ses düzeyini ölçer, istenirse ölçüme ses kaydeder ve bir gözleme ait kısa kliplerin sesini kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm вимірює гучність, за потреби записує звук до вимірювання й записує звук коротких кліпів до спостереження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 会测量音量，按需要为测量录制声音，并录制观测点短片段的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 會量測音量，並可在量測時一併錄音，也會錄下觀測點所屬短片的聲音。"
          }
        }
      }
    },
