        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Sensorstorm καταγράφει θέση, υψόμετρο, ταχύτητα και πορεία, ευθυγραμμίζει τα δεδομένα προσανατολισμού προς τον βορρά και κρατά πού καταγράφηκε μια παρατήρηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm records position, altitude, speed and course, references the orientation data to true north, and records where an observation was captured."
