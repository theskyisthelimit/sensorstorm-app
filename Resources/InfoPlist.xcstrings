{
  "sourceLanguage" : "de",
  "strings" : {
    "NFCReaderUsageDescription" : {
      "comment" : "Privacy - NFC Scan Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm reads and writes NFC tags on request: as checkpoints on objects you inspect, and in the NFC tool."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصي Sensorstorm عدد أجهزة Bluetooth التي تبثّ في المحيط ويسجّل قوة الإشارة. ولا يُنشأ أي اتصال بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm počítá, kolik zařízení Bluetooth v okolí vysílá, a zaznamenává sílu signálu. Spojení s nimi se nenavazuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm tæller, hvor mange Bluetooth-enheder der sender i omgivelserne, og registrerer signalstyrken. Der oprettes ingen forbindelse til dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm zählt, wie viele Bluetooth-Geräte in der Umgebung senden, und zeichnet die Signalstärke auf. Es wird keine Verbindung zu ihnen aufgebaut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sensorstorm μετράει πόσες συσκευές Bluetooth εκπέμπουν στο περιβάλλον και καταγράφει την ισχύ σήματος. Δεν δημιουργείται σύνδεση μαζί τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm counts how many Bluetooth devices are advertising nearby and records their signal strength. It never connects to any of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm cuenta cuántos dispositivos Bluetooth están emitiendo cerca y registra la intensidad de la señal. No se establece ninguna conexión con ellos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm laskee, kuinka monta Bluetooth-laitetta ympäristössä lähettää, ja tallentaa signaalin voimakkuuden. Niihin ei muodosteta yhteyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm compte combien d'appareils Bluetooth émettent aux alentours et enregistre la puissance du signal. Aucune connexion n'est établie avec eux."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm broji koliko Bluetooth uređaja odašilje u okolini i bilježi jačinu signala. Veza s njima se ne uspostavlja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sensorstorm megszámolja, hány Bluetooth-eszköz sugároz a környezetben, és rögzíti a jelerősséget. Nem épít ki kapcsolatot velük."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm conta quanti dispositivi Bluetooth stanno trasmettendo nelle vicinanze e registra l'intensità del segnale. Non viene stabilita alcuna connessione con essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm は周囲で発信している Bluetooth 機器の数を数え、信号強度を記録します。それらの機器に接続することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm은 주변에서 신호를 보내는 Bluetooth 기기의 수를 세고 신호 세기를 기록합니다. 해당 기기에 연결하지는 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm teller hvor mange Bluetooth-enheter som sender i omgivelsene, og registrerer signalstyrken. Det opprettes ingen tilkobling til dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm telt hoeveel Bluetooth-apparaten in de buurt uitzenden en registreert de signaalsterkte. Er wordt geen verbinding met ze gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm liczy, ile urządzeń Bluetooth nadaje w otoczeniu, i zapisuje siłę sygnału. Połączenie z nimi nie jest nawiązywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm conta quantos dispositivos Bluetooth estão transmitindo por perto e registra a intensidade do sinal. Nenhuma conexão é estabelecida com eles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm conta quantos aparelhos Bluetooth estão a emitir nas proximidades e regista a força do sinal. Não é estabelecida qualquer ligação com eles."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm numără câte dispozitive Bluetooth emit în jur și înregistrează puterea semnalului. Nu se stabilește nicio conexiune cu ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm считает, сколько устройств Bluetooth передают поблизости, и записывает силу сигнала. Соединение с ними не устанавливается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm počíta, koľko zariadení Bluetooth v okolí vysiela, a zaznamenáva silu signálu. Spojenie s nimi sa nenadväzuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm räknar hur många Bluetooth-enheter som sänder i omgivningen och registrerar signalstyrkan. Ingen anslutning upprättas till dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm çevrede kaç Bluetooth cihazının yayın yaptığını sayar ve sinyal gücünü kaydeder. Onlarla bağlantı kurulmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm рахує, скільки пристроїв Bluetooth передають поблизу, і записує силу сигналу. З’єднання з ними не встановлюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 会统计周围有多少 Bluetooth 设备正在发送信号，并记录信号强度，不会与这些设备建立连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 會統計周圍有多少藍牙裝置正在發送訊號，並記錄訊號強度，不會與這些裝置建立連線。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل Sensorstorm الفيديو متزامنًا مع بيانات المستشعرات ويصوّر الأرضية لأجل ملاحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm nahrává video synchronně s daty senzorů a fotografuje povrch pro pozorování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm optager video synkront med sensordataene og fotograferer belægningen til en observation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm nimmt Video synchron zu den Sensordaten auf und fotografiert den Boden für eine Beobachtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sensorstorm καταγράφει βίντεο συγχρονισμένο με τα δεδομένα αισθητήρων και φωτογραφίζει το οδόστρωμα για μια παρατήρηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm records video in sync with the sensor data and photographs the ground for an observation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm graba vídeo sincronizado con los datos de los sensores y fotografía el suelo para una observación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm tallentaa videon samanaikaisesti anturidatan kanssa ja valokuvaa päällysteen havaintoa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm enregistre la vidéo en synchronisation avec les données des capteurs et photographie le sol pour une observation."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm snima videozapis usklađeno s podacima senzora i fotografira kolnik za opažanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sensorstorm az érzékelőadatokkal szinkronban rögzít videót, és lefotózza a burkolatot egy észleléshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm registra video in sincronia con i dati dei sensori e fotografa il terreno per un'osservazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm はセンサーデータと同期して動画を記録し、観測点のために地面を撮影します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm은 센서 데이터와 동기화하여 영상을 기록하고, 관측을 위해 지면을 촬영합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm tar opp video synkront med sensordataene og fotograferer dekket for en observasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm neemt video op synchroon met de sensordata en fotografeert de ondergrond voor een waarneming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm nagrywa wideo synchronicznie z danymi czujników i fotografuje nawierzchnię do obserwacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm grava vídeo em sincronia com os dados dos sensores e fotografa o solo para uma observação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sensorstorm grava vídeo em sincronia com os dados dos sensores e fotografa o piso para uma observação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm înregistrează video sincron cu datele senzorilor și fotografiază îmbrăcămintea pentru o observație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm снимает видео синхронно с данными датчиков и фотографирует покрытие для наблюдения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm nahráva video synchrónne s dátami senzorov a fotografuje povrch pre pozorovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm spelar in video synkront med sensordatan och fotograferar beläggningen för en observation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm sensör verileriyle eşzamanlı video kaydeder ve bir gözlem için zemini fotoğraflar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm знімає відео синхронно з даними датчиків і фотографує покриття для спостереження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 会录制与传感器数据同步的视频，并为观测点拍摄地面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorstorm 會與感測器資料同步錄影，並為觀測點拍攝地面。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقرأ Sensorstorm عند الطلب النبض والتنفس والأكسجين والخطوات ومقاييس الجري من وقت تسجيل ويضعها بجانب القيم المقاسة الأخرى. ولا يُكتب شيء في «الصحة»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm na požádání čte tep, dýchání, kyslík, kroky a metriky běhu z doby záznamu a ukládá je vedle ostatních naměřených hodnot. Do Zdraví se nic nezapisuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm læser efter ønske puls, vejrtrækning, ilt, skridt og løbemetrikker fra tidsrummet for en optagelse og lægger dem ved siden af de øvrige målinger. Der skrives intet i Sundhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Sensorstorm διαβάζει, όταν το ζητήσεις, καρδιακούς παλμούς, αναπνοή, οξυγόνο, βήματα και μετρικές τρεξίματος από τον χρόνο μιας εγγραφής και τα τοποθετεί δίπλα στις υπόλοιπες τιμές μέτρησης. Τίποτα δεν γράφεται στην Υγεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "On request, Sensorstorm reads heart rate, breathing, oxygen, steps and running metrics from the time of a recording and places them next to the other measurements. Nothing is written to Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si lo pides, Sensorstorm lee pulso, respiración, oxígeno, pasos y métricas de carrera del período de una grabación y los coloca junto a los demás valores medidos. No se escribe nada en Salud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm lukee pyydettäessä sykkeen, hengityksen, happisaturaation, askeleet ja juoksumittarit tallenteen ajalta ja asettaa ne muiden mittausarvojen viereen. Terveys-sovellukseen ei kirjoiteta mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm lit, à votre demande, pouls, respiration, oxygène, pas et métriques de course sur la durée d’un enregistrement et les place à côté des autres mesures. Rien n’est écrit dans Santé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm na zahtjev čita puls, disanje, kisik, korake i metrike trčanja iz vremena snimke i stavlja ih uz ostale mjerne vrijednosti. U Zdravlje se ništa ne zapisuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Sensorstorm kérésedre kiolvassa a pulzust, a légzést, az oxigént, a lépéseket és a futási mutatókat egy felvétel idejéből, és a többi mérési érték mellé teszi őket. Az Egészség appba semmi sem íródik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se vuoi, Sensorstorm legge battito, respirazione, ossigeno, passi e metriche di corsa dal periodo di una registrazione e li affianca alle altre misure. Non viene scritto nulla in Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm は、ご希望の場合に、記録の時間帯の脈拍、呼吸、酸素、歩数、ランニング指標を読み取り、他の測定値と並べて保存します。ヘルスケアには何も書き込みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "원하면 Sensorstorm이 기록 시간대의 심박수, 호흡, 산소, 걸음 수, 러닝 지표를 읽어 다른 측정값 옆에 놓아요. 건강 앱에는 아무것도 쓰지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm leser på forespørsel puls, respirasjon, oksygen, skritt og løpemål fra tiden for et opptak og legger dem ved siden av de andre måleverdiene. Det skrives ikke noe i Helse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm leest op verzoek hartslag, ademhaling, zuurstof, stappen en loopgegevens uit de tijd van een opname en legt ze naast de overige metingen. Er wordt niets naar Gezondheid geschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na życzenie Sensorstorm odczytuje tętno, oddech, tlen, kroki i wskaźniki biegu z czasu nagrania i umieszcza je obok pozostałych pomiarów. Nic nie jest zapisywane w aplikacji Zdrowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando você pede, o Sensorstorm lê frequência cardíaca, respiração, oxigênio, passos e métricas de corrida do período de uma gravação e os coloca ao lado das demais medições. Nada é gravado no Saúde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando pedido, o Sensorstorm lê pulsação, respiração, oxigénio, passos e métricas de corrida do período de uma gravação e coloca-os junto das restantes medições. Nada é escrito na app Saúde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm citește, la cerere, pulsul, respirația, oxigenul, pașii și metricile de alergare din intervalul unei înregistrări și le pune lângă celelalte valori măsurate. Nu se scrie nimic în Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По вашему запросу Sensorstorm считывает пульс, дыхание, кислород, шаги и показатели бега за время записи и кладёт их рядом с остальными измеренными значениями. В Health ничего не записывается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm na požiadanie číta tep, dych, kyslík, kroky a bežecké metriky z času záznamu a ukladá ich k ostatným nameraným hodnotám. Do aplikácie Zdravie sa nič nezapisuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm läser på begäran puls, andning, syre, steg och löpmått från tiden för en inspelning och lägger dem bredvid de andra mätvärdena. Ingenting skrivs till Hälsa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İstersen Sensorstorm, bir kaydın zamanından nabız, solunum, oksijen, adım ve koşu ölçütlerini okur ve diğer ölçüm değerlerinin yanına koyar. Sağlık’a hiçbir şey yazılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sensorstorm на ваше прохання читає пульс, дихання, кисень, кроки та показники бігу за час запису й кладе їх поряд з іншими виміряними значеннями. У «Здоров’я» нічого не записується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "应你的要求，Sensorstorm 会读取一次记录期间的心率、呼吸、血氧、步数和跑步指标，并把它们与其他测量值放在一起。不会向“健康”写入任何内容。"
          }
        },
        "zh-Hant" : {
