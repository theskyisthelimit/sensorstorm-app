    "Misst Signal und Entfernung zu iBeacons mit den eingetragenen Kennungen. Nur im Vordergrund." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقيس الإشارة والمسافة إلى iBeacons ذات المعرّفات المدخلة. في المقدمة فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Měří signál a vzdálenost k iBeaconům se zadanými identifikátory. Jen na popředí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler signal og afstand til iBeacons med de indtastede id'er. Kun i forgrunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μετρά σήμα και απόσταση από iBeacons με τα αναγνωριστικά που έχεις καταχωρίσει. Μόνο στο προσκήνιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Measures signal and distance to iBeacons with the identifiers you entered. Foreground only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mide la señal y la distancia a iBeacons con los identificadores introducidos. Solo en primer plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mittaa signaalin ja etäisyyden iBeacon-laitteisiin annetuilla tunnisteilla. Vain etualalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mesure le signal et la distance jusqu’aux iBeacons ayant les identifiants saisis. Au premier plan uniquement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mjeri signal i udaljenost do iBeacona s upisanim identifikatorima. Samo u prvom planu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Méri a jelet és a távolságot az iBeacon-eszközökhöz a megadott azonosítókkal. Csak előtérben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Misura segnale e distanza dagli iBeacon con gli ID inseriti. Solo in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
