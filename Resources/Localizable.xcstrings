        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Směrná hodnota ze svislého zrychlení, ne měření podle normy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Retningsværdi ud fra lodret acceleration, ikke en måling efter standard."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τιμή αναφοράς από την κάθετη επιτάχυνση, όχι μέτρηση κατά πρότυπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
