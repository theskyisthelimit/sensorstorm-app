          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valor de referencia a partir de la aceleración vertical, no una medición conforme a norma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ohjearvo pystykiihtyvyydestä, ei standardin mukainen mittausarvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
