    "Keine Fahrt gefunden. Das Telefon muss im Aufzug auf dem Boden liegen; gesucht wird eine Höhenänderung ab 1,5 m." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenalezena žádná jízda. Telefon musí ve výtahu ležet na podlaze; hledá se změna výšky od 1,5 m."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen tur fundet. Telefonen skal ligge på gulvet i elevatoren. Der søges efter en højdeændring på 1,5 m eller mere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No ride found. The phone must lie on the floor in the lift; a height change of 1.5 m or more is searched for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha encontrado ningún viaje. El teléfono debe estar en el suelo del ascensor; se busca un cambio de altura de 1,5 m o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun trajet trouvé. Le téléphone doit être posé au sol dans l’ascenseur ; on recherche un changement d’altitude d’au moins 1,5 m."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nessuna corsa trovata. Il telefono deve stare sul pavimento dell'ascensore; si cerca una variazione di quota da 1,5 m."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移動が見つかりません。iPhone をエレベーターの床に置いてください。1.5 m 以上の高度変化を探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이동을 찾지 못했어요. 휴대폰이 엘리베이터 바닥에 놓여 있어야 해요. 높이가 1.5 m 이상 바뀐 구간을 찾아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fant ingen tur. Telefonen må ligge på gulvet i heisen; det søkes etter en høydeendring på 1,5 m eller mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geen rit gevonden. De telefoon moet in de lift op de vloer liggen; er wordt gezocht naar een hoogteverandering vanaf 1,5 m."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie znaleziono przejazdu. Telefon musi leżeć w windzie na podłodze; szukana jest zmiana wysokości od 1,5 m."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma viagem encontrada. O celular precisa ficar no chão do elevador; procura-se uma variação de altura de 1,5 m ou mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma viagem encontrada. O telemóvel tem de estar no chão do elevador; procura-se uma variação de altura de 1,5 m ou mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nicio cursă găsită. Telefonul trebuie să stea pe podea în lift; se caută o schimbare de înălțime de cel puțin 1,5 m."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenašla sa žiadna jazda. Telefón musí ležať vo výťahu na podlahe; hľadá sa zmena výšky od 1,5 m."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen resa hittades. Telefonen måste ligga på golvet i hissen; sökningen gäller en höjdändring på 1,5 m eller mer."
