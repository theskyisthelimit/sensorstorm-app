    "Schalte oben die Kamera ein. Ohne Bild gibt es keine Kamerapose." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Switch the camera on above. Without an image there is no camera pose."
