        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten posisjon kan en observasjon ikke finnes igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder positie is een waarneming niet terug te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pozycji obserwacji nie da się odnaleźć ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem posição não é possível reencontrar uma observação."
          }
