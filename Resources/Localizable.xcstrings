    "GPS hatte %@, %@ gemeldet. Beides ist gespeichert." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغ GPS عن %@ و%@. كلاهما محفوظ."
          }
        },
