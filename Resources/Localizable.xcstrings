    "Gilt für alle Bewegungssensoren. GPS, Barometer und Schrittzähler liefern in ihrem eigenen Takt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every motion sensor. GPS, barometer and pedometer report at their own cadence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à tous les capteurs de mouvement. GPS, baromètre et podomètre livrent à leur propre rythme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per tutti i sensori di movimento. GPS, barometro e contapassi forniscono dati con il proprio ritmo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todos los sensores de movimiento. El GPS, el barómetro y el podómetro entregan datos a su propio ritmo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor alle bewegingssensoren. GPS, barometer en stappenteller leveren in hun eigen tempo."
          }
        }
      }
    },
