    "Starte auf dem Tab „Aufnehmen“ deine erste Messung." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ قياسك الأول في علامة التبويب «تسجيل»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte první měření na kartě „Nahrávat“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start din første måling på fanen »Optag«."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκίνα την πρώτη σου μέτρηση στην καρτέλα «Εγγραφή»."
          }
        },
