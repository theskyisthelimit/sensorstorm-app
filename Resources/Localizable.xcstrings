    "Für ein eigenes Dashboard, Node-RED oder Home Assistant. Ohne eingetragene Adresse baut die App keine Verbindung auf." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للوحة معلومات خاصة بك أو Node-RED أو Home Assistant. بدون عنوان مُدخل لا ينشئ التطبيق أي اتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro vlastní dashboard, Node-RED nebo Home Assistant. Bez zadané adresy aplikace spojení nenaváže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til et eget dashboard, Node-RED eller Home Assistant. Uden en indtastet adresse opretter appen ingen forbindelse."
