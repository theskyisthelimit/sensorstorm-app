          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "입력한 식별자의 iBeacon까지의 신호와 거리를 측정해요. 포그라운드에서만 동작해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler signal og avstand til iBeacons med de innlagte ID-ene. Bare i forgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
