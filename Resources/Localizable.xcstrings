            "value" : "‘%@’ noemt geen van manufacturerId, serviceUuid of namePrefix."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@” nie podaje ani manufacturerId, ani serviceUuid, ani namePrefix."
          }
        },
        "pt-BR" : {
