    "Zu diesem Apple-Account wurde kein Kauf von Sensorstorm Pro gefunden." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على شراء Sensorstorm Pro في حساب Apple هذا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K tomuto účtu Apple nebyl nalezen žádný nákup Sensorstorm Pro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet noget køb af Sensorstorm Pro på denne Apple-konto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε αυτόν τον λογαριασμό Apple δεν βρέθηκε αγορά Sensorstorm Pro."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No purchase of Sensorstorm Pro was found for this Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado ninguna compra de Sensorstorm Pro para esta cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tältä Apple-tililtä ei löytynyt Sensorstorm Pro -ostoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat de Sensorstorm Pro n'a été trouvé pour ce compte Apple."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz ovaj Apple račun nije pronađena kupnja Sensorstorm Pro."
          }
        },
