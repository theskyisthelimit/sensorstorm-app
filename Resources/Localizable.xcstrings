    "Schalte oben die Kamera ein — ohne Bild gibt es keine Kamerapose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the camera on above — without an image there is no camera pose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la caméra ci-dessus — sans image, pas de pose de caméra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la fotocamera qui sopra — senza immagine non c'è posa della fotocamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la cámara arriba: sin imagen no hay pose de cámara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet hierboven de camera aan — zonder beeld is er geen camerapose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue a câmera acima — sem imagem não há pose da câmera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上でカメラをオンにしてください。映像がなければカメラポーズもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 카메라를 켜세요. 영상이 없으면 카메라 포즈도 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在上方開啟相機 — 沒有畫面就沒有相機姿態。"
