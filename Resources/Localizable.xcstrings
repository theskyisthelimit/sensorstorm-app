    "Zu wenig freier Speicher für eine Aufnahme.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free storage for a recording."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre insuffisant pour un enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero insufficiente per una registrazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio libre suficiente para una grabación."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig vrije opslag voor een opname."
          }
        },
        "pt-BR": {
