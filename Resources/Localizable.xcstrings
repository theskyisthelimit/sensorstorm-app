    "Bewegungssensoren bei 400 Hz statt 200 Hz — die Auflösung, in der Vibrationen und Stösse noch als Form erkennbar sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion sensors at 400 Hz instead of 200 Hz — the resolution at which vibrations and shocks still have a recognisable shape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capteurs de mouvement à 400 Hz au lieu de 200 Hz — la résolution à laquelle vibrations et chocs gardent encore une forme reconnaissable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensori di movimento a 400 Hz anziché 200 Hz — la risoluzione alla quale vibrazioni e urti hanno ancora una forma riconoscibile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensores de movimiento a 400 Hz en lugar de 200 Hz: la resolución a la que vibraciones y golpes aún tienen una forma reconocible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegingssensoren op 400 Hz in plaats van 200 Hz — de resolutie waarbij trillingen en schokken nog een herkenbare vorm houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensores de movimento a 400 Hz em vez de 200 Hz — a resolução em que vibrações e impactos ainda têm uma forma reconhecível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーションセンサーを 200 Hz ではなく 400 Hz で。振動や衝撃がまだ形として見て取れる分解能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모션 센서를 200 Hz가 아닌 400 Hz로. 진동과 충격이 아직 형태로 보이는 해상도입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運動感測器以 400 Hz 而非 200 Hz 取樣 — 在這個解析度下，振動與衝擊仍看得出形狀。"
          }
        }
      }
    },
