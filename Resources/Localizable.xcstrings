    "„%@“ nennt weder manufacturerId noch serviceUuid noch namePrefix." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» لا يذكر manufacturerId ولا serviceUuid ولا namePrefix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@“ neuvádí manufacturerId, serviceUuid ani namePrefix."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "»%@« angiver hverken manufacturerId, serviceUuid eller namePrefix."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το «%@» δεν αναφέρει ούτε manufacturerId ούτε serviceUuid ούτε namePrefix."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” names neither manufacturerId nor serviceUuid nor namePrefix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» no indica ni manufacturerId ni serviceUuid ni namePrefix."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "”%@” ei määritä manufacturerId-, serviceUuid- eikä namePrefix-arvoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %@ » ne mentionne ni manufacturerId, ni serviceUuid, ni namePrefix."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@“ ne navodi ni manufacturerId ni serviceUuid ni namePrefix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@” nem ad meg sem manufacturerId-t, sem serviceUuid-t, sem namePrefix-et."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» non indica né manufacturerId né serviceUuid né namePrefix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%@」には manufacturerId、serviceUuid、namePrefix のいずれも指定されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@”에 manufacturerId, serviceUuid, namePrefix가 모두 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» nevner verken manufacturerId, serviceUuid eller namePrefix."
          }
        },
        "nl" : {
          "stringUnit" : {
