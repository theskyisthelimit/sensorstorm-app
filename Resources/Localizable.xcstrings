    "Dafür braucht es Beschleunigung mit mindestens 100 Hz über mehr als vier Sekunden." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "K tomu je potřeba zrychlení s frekvencí alespoň 100 Hz po dobu delší než čtyři sekundy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det kræver acceleration på mindst 100 Hz i mere end fire sekunder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This needs acceleration of at least 100 Hz over more than four seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para ello se necesita aceleración a 100 Hz o más durante más de cuatro segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il faut pour cela une accélération d’au moins 100 Hz sur plus de quatre secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Servono accelerazione ad almeno 100 Hz per più di quattro secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "100 Hz 以上の加速度が 4 秒を超えて必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "100 Hz 이상의 가속도가 4초 넘게 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det krever akselerasjon på minst 100 Hz over mer enn fire sekunder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiervoor is versnelling met minstens 100 Hz over meer dan vier seconden nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wymaga to przyspieszenia co najmniej 100 Hz przez ponad cztery sekundy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para isso é preciso aceleração de pelo menos 100 Hz por mais de quatro segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para isso é preciso aceleração de, pelo menos, 100 Hz durante mais de quatro segundos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru asta este nevoie de accelerație de cel puțin 100 Hz pe mai mult de patru secunde."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyžaduje zrýchlenie s aspoň 100 Hz dlhšie ako štyri sekundy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det kräver acceleration på minst 100 Hz under mer än fyra sekunder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这需要超过四秒、至少 100 Hz 的加速度数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這需要超過四秒、至少 100 Hz 的加速度資料。"
          }
        }
      }
    },
    "Dafür braucht es mindestens zehn Sekunden Beschleunigung mit 20 Hz oder mehr." : {
