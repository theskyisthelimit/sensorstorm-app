    "Neigung, Tiefe, Breite, Länge oder Stückzahl. Aus Fläche und Tiefe rechnet die App das Volumen aus." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الميل أو العمق أو العرض أو الطول أو العدد. يحسب التطبيق الحجم من المساحة والعمق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sklon, hloubka, šířka, délka nebo počet kusů. Z plochy a hloubky aplikace vypočítá objem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hældning, dybde, bredde, længde eller antal. Ud fra areal og dybde beregner appen volumen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κλίση, βάθος, πλάτος, μήκος ή αριθμός τεμαχίων. Από το εμβαδόν και το βάθος η εφαρμογή υπολογίζει τον όγκο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slope, depth, width, length or quantity. From surface area and depth the app calculates the volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inclinación, profundidad, anchura, longitud o número de unidades. A partir de superficie y profundidad, la app calcula el volumen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaltevuus, syvyys, leveys, pituus tai kappalemäärä. Pinta-alasta ja syvyydestä sovellus laskee tilavuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pente, profondeur, largeur, longueur ou quantité. À partir de la surface et de la profondeur, l’app calcule le volume."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nagib, dubina, širina, duljina ili količina. Iz površine i dubine aplikacija izračunava volumen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lejtés, mélység, szélesség, hossz vagy darabszám. A területből és a mélységből az app kiszámítja a térfogatot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pendenza, profondità, larghezza, lunghezza o quantità. Da superficie e profondità l'app calcola il volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "傾斜、深さ、幅、長さ、数量。面積と深さから、アプリが体積を計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "경사, 깊이, 너비, 길이 또는 수량. 면적과 깊이로 앱이 부피를 계산해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Helning, dybde, bredde, lengde eller antall. Av areal og dybde regner appen ut volumet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Helling, diepte, breedte, lengte of aantal. Uit oppervlakte en diepte berekent de app het volume."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nachylenie, głębokość, szerokość, długość lub liczba sztuk. Z powierzchni i głębokości aplikacja oblicza objętość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inclinação, profundidade, largura, comprimento ou quantidade. A partir de área e profundidade, o app calcula o volume."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inclinação, profundidade, largura, comprimento ou quantidade. A partir da superfície e da profundidade, a app calcula o volume."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Înclinare, adâncime, lățime, lungime sau număr de bucăți. Din suprafață și adâncime, aplicația calculează volumul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Наклон, глубина, ширина, длина или количество. По площади и глубине приложение вычисляет объём."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sklon, hĺbka, šírka, dĺžka alebo počet kusov. Z plochy a hĺbky aplikácia vypočíta objem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lutning, djup, bredd, längd eller antal. Av yta och djup räknar appen ut volymen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eğim, derinlik, genişlik, uzunluk ya da adet. Uygulama yüzey alanı ve derinlikten hacmi hesaplar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нахил, глибина, ширина, довжина або кількість. За площею й глибиною застосунок обчислює об’єм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "坡度、深度、宽度、长度或数量。应用会根据面积和深度计算体积。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "坡度、深度、寬度、長度或數量。App 會根據面積與深度算出體積。"
          }
        }
      }
