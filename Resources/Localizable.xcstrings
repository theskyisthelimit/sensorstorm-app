    "Alle 1,5 m ein Bild. Für einen abgelaufenen Weg oder eine Strasse." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صورة كل 1٫5 m. لمسار مقطوع أو لشارع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímek každých 1,5 m. Pro prošlou cestu nebo ulici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et billede for hver 1,5 m. Til en gået sti eller en vej."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία εικόνα κάθε 1,5 m. Για ένα μονοπάτι που περπάτησες ή έναν δρόμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An image every 1.5 m. For a path you walked or a street."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una imagen cada 1,5 m. Para un camino recorrido o una calle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva 1,5 metrin välein. Kuljetulle polulle tai kadulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une image tous les 1,5 m. Pour un chemin parcouru ou une rue."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snimka svakih 1,5 m. Za prijeđenu stazu ili ulicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kép 1,5 méterenként. Bejárt ösvényhez vagy utcához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’immagine ogni 1,5 m. Per un percorso camminato o una strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.5 m ごとに 1 枚。歩いた道や街路に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.5 m마다 한 장. 걸어간 길이나 도로에 적합합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett bilde hver 1,5 m. For en gått sti eller en gate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke 1,5 m een beeld. Voor een gelopen pad of een straat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcie co 1,5 m. Do przejścia ścieżki albo ulicy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma imagem a cada 1,5 m. Para um caminho percorrido ou uma rua."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma imagem a cada 1,5 m. Para um caminho percorrido ou uma rua."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O imagine la fiecare 1,5 m. Pentru o potecă parcursă sau o stradă."
