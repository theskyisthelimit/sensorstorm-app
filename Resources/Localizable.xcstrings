        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточний запис займає камеру. Запишіть спостереження без фото або зупиніть запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在进行的记录占用着相机。可以不带照片采集观测点，或者先停止记录。"
