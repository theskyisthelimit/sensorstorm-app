    "Ungefähr %@. Das Archiv wird danach zum Teilen angeboten — Dateien, AirDrop, Mail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roughly %@. The archive is then offered for sharing — Files, AirDrop, Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@. L'archive sera ensuite proposée au partage — Fichiers, AirDrop, Mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@. L'archivio verrà poi proposto per la condivisione — File, AirDrop, Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadamente %@. Después se ofrecerá el archivo para compartir: Archivos, AirDrop, Mail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer %@. Daarna wordt het archief aangeboden om te delen — Bestanden, AirDrop, Mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@. Depois o arquivo será oferecido para compartilhar — Arquivos, AirDrop, Mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "およそ %@。作成後、アーカイブは共有できます — ファイル、AirDrop、メール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@. 만든 뒤 아카이브를 공유할 수 있습니다 — 파일, AirDrop, 메일."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@。建立後即可分享封存檔 — 檔案、AirDrop、郵件。"
          }
        }
      }
    },
    "Unter freiem Himmel dauert das ein paar Sekunden.": {
