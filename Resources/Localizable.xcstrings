          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間不足，無法進行記錄。"
          }
        }
      }
    },
    "Zu wenige Fixes für eine Mittelung — unter freiem Himmel nochmals versuchen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too few fixes to average — try again under open sky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop peu de points pour une moyenne — réessayez à ciel ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo pochi fix per una media — riprova a cielo aperto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados pocos fixes para promediar: inténtalo de nuevo a cielo abierto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig fixes om te middelen — probeer het opnieuw onder de blote hemel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes de menos para calcular a média — tente de novo a céu aberto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均を取るにはフィックスが少なすぎます。屋外でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평균을 내기에는 픽스가 너무 적습니다. 탁 트인 곳에서 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定位點太少，無法取平均 — 請到開闊處再試一次。"
          }
        }
      }
    },
