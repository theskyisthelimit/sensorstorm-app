      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Severity %@"
          }
        }
      }
    },
    "Bildschirm aktiv lassen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep screen awake"
          }
        }
      }
    },
