          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start den første målingen din i fanen «Ta opp»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start je eerste meting op het tabblad ‘Opnemen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij pierwszy pomiar na karcie „Nagrywaj”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece sua primeira medição na aba “Gravar”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
