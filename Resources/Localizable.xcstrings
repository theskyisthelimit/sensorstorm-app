    "Zu wenige Fixes für eine Mittelung. Versuche es unter freiem Himmel nochmals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقاط أقل من أن يُؤخذ متوسط. حاول مجددًا تحت السماء المفتوحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš málo fixů pro průměrování. Zkuste to znovu pod otevřeným nebem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For få fix til en midling. Prøv igen under åben himmel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ λίγα στίγματα για μέσο όρο. Δοκίμασε ξανά κάτω από ανοιχτό ουρανό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too few fixes to average. Try again under open sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy pocos fix para promediar. Inténtalo de nuevo a cielo abierto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian vähän fixejä keskiarvoistukseen. Yritä uudelleen avoimen taivaan alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop peu de points pour une moyenne. Réessayez à ciel ouvert."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premalo fixeva za prosjek. Pokušaj ponovno pod otvorenim nebom."
