    "Die Antwortzeit steigt unter Last stark. Das deutet auf einen überfüllten Puffer im Router hin (Bufferbloat)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرتفع زمن الاستجابة بشدة تحت الحمل. وهذا يشير إلى ازدحام المخزن المؤقت في الموجّه (Bufferbloat)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doba odezvy při zátěži výrazně roste. To ukazuje na přeplněnou vyrovnávací paměť v routeru (bufferbloat)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svartiden stiger kraftigt under belastning. Det tyder på en overfyldt buffer i routeren (bufferbloat)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο χρόνος απόκρισης αυξάνεται πολύ υπό φορτίο. Αυτό δείχνει υπερπλήρη προσωρινή μνήμη στον δρομολογητή (bufferbloat)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Response time rises sharply under load. This points to an overfull buffer in the router (bufferbloat)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El tiempo de respuesta sube mucho bajo carga. Esto apunta a un búfer saturado en el router (bufferbloat)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vasteaika kasvaa voimakkaasti kuormitettaessa. Se viittaa reitittimen ylitäyteen puskuriin (bufferbloat)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
