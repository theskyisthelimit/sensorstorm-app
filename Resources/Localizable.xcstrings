    "Alle paar Meter ein Punkt, auch bei gesperrtem Bildschirm. iOS zeigt dafür den blauen Streifen an." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každých pár metrů jeden bod, i při zamčené obrazovce. iOS k tomu zobrazuje modrý pruh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et punkt for hver få meter, også når skærmen er låst. iOS viser den blå bjælke til det."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A point every few metres, even with the screen locked. iOS shows the blue bar for this."
