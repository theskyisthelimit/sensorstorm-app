        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia la tua prima misura dalla scheda «Registra»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「記録する」タブから最初の測定を始めてください。"
