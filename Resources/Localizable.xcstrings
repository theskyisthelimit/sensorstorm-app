          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O percurso em GeoJSON para o QGIS, em KML para o Google Earth, em GPX para reencontrar o ponto, ou como pacote com cada foto e cada clipe."
          }
        },
