    },
    "Der Kauf wartet auf Freigabe. Sobald sie erteilt ist, schaltet sich Pro von selbst frei.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is waiting for approval. Pro unlocks itself as soon as it is granted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat attend une autorisation. Dès qu'elle est donnée, Pro se débloque tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è in attesa di approvazione. Appena arriva, Pro si sblocca da solo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está esperando aprobación. En cuanto llegue, Pro se desbloquea solo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop wacht op goedkeuring. Zodra die er is, wordt Pro vanzelf vrijgegeven."
          }
        }
      }
    },
