    "Kein Zugriff auf den Standort. Ohne ihn bleibt nur die Nadel von Hand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا وصول إلى الموقع. وبدونه يبقى الدبوس اليدوي فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez přístupu k poloze. Bez ní zbývá jen špendlík ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen adgang til lokaliteten. Uden den er der kun nålen i hånden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία πρόσβαση στην τοποθεσία. Χωρίς αυτήν μένει μόνο η πινέζα με το χέρι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No access to location. Without it only the hand-placed pin remains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a la ubicación. Sin ella solo queda la chincheta puesta a mano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei pääsyä sijaintiin. Ilman sitä jää vain käsin asetettu nuppineula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'accès à la localisation. Sans elle, il ne reste que l'épingle posée à la main."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema pristupa lokaciji. Bez nje ostaje samo pribadača ručno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs hozzáférés a helyzethez. Nélküle csak a kézzel elhelyezett tű marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun accesso alla posizione. Senza di essa resta solo lo spillo posato a mano."
          }
        },
