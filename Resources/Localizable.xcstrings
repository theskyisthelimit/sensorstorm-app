    "Alle Sensoren in einer Tabelle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sensors in one table"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les capteurs dans un seul tableau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i sensori in un'unica tabella"
          }
        },
        "es": {
