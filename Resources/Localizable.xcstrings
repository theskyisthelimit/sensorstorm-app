        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "走行が少なすぎて評価できません。20 Hz 以上の加速度と、11〜160 km/h の速度が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "평가하기에는 이동이 부족해요. 20 Hz 이상의 가속도와 11~160 km/h의 속도가 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
