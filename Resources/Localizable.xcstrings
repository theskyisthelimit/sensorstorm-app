          }
        }
      }
    },
    "Für ein eigenes Dashboard, Node-RED oder Home Assistant. Ohne eingetragene Adresse baut die App keine Verbindung auf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your own dashboard, Node-RED or Home Assistant. With no address entered, the app opens no connection at all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre propre tableau de bord, Node-RED ou Home Assistant. Sans adresse saisie, l'app n'ouvre aucune connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una dashboard tua, Node-RED o Home Assistant. Senza un indirizzo inserito, l'app non apre alcuna connessione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tu propio panel, Node-RED o Home Assistant. Sin una dirección introducida, la app no abre ninguna conexión."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor je eigen dashboard, Node-RED of Home Assistant. Zonder ingevuld adres maakt de app geen enkele verbinding."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o seu próprio painel, Node-RED ou Home Assistant. Sem um endereço preenchido, o app não abre conexão nenhuma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自作のダッシュボード、Node-RED、Home Assistant 向けです。アドレスが未入力なら、アプリは接続を一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 대시보드, Node-RED, Home Assistant를 위한 기능입니다. 주소를 입력하지 않으면 앱은 어떤 연결도 열지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於自建的儀表板、Node-RED 或 Home Assistant。若未填入位址，App 不會建立任何連線。"
          }
        }
      }
    },
