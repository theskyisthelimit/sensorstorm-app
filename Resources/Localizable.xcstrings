    "Position wird gesucht … Ohne Fix oder gesetzte Nadel lässt sich der Fall nicht sichern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your position … Without a fix or a placed pin the case cannot be saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de la position … Sans point GPS ni épingle posée, le cas ne peut pas être enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca della posizione … Senza fix o spillo posato il caso non può essere salvato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando la posición … Sin fix ni chincheta puesta, el caso no se puede guardar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Positie wordt gezocht … Zonder fix of geplaatste speld kan het geval niet worden bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando a posição … Sem fix nem alfinete colocado, o caso não pode ser salvo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置を取得中 … フィックスもピンもない状態では事案を保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 찾는 중 … 픽스도 핀도 없으면 사례를 저장할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取得位置 … 沒有定位點也沒有放置圖釘時，無法儲存案件。"
          }
        }
      }
    },
