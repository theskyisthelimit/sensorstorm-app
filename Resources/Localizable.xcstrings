        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje dla każdego zdjęcia pozycję, kierunek patrzenia i ogniskową. Dopiero dzięki temu zdjęcia da się umieścić w ich miejscu w scenie 3D."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra para cada imagem a posição, a direção de visada e a distância focal. Só assim as imagens podem ser colocadas no seu lugar em uma cena 3D."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
