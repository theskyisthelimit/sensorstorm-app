    "Mehr Ports heisst längere Suche. Die Liste mit 1 bis 1024 braucht je Gerät einige Sekunden." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Více portů znamená delší hledání. Seznam 1 až 1024 trvá u každého zařízení několik sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Flere porte betyder længere søgning. Listen med 1 til 1024 tager nogle sekunder pr. enhed."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "More ports means a longer search. The list of 1 to 1024 takes a few seconds per device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Más puertos significa una búsqueda más larga. La lista de 1 a 1024 tarda unos segundos por dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plus de ports, c’est une recherche plus longue. La liste de 1 à 1024 prend quelques secondes par appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Più porte significa una ricerca più lunga. L'elenco da 1 a 1024 richiede alcuni secondi per dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ポート数が増えるほど検索に時間がかかります。1 〜 1024 のリストは、端末 1 台あたり数秒かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "포트가 많을수록 검색이 오래 걸려요. 1~1024 목록은 기기당 몇 초가 걸려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Flere porter betyr lengre søk. Listen med 1 til 1024 bruker noen sekunder per enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meer poorten betekent langer zoeken. De lijst van 1 tot 1024 kost per apparaat enkele seconden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Więcej portów oznacza dłuższe wyszukiwanie. Lista od 1 do 1024 zajmuje kilka sekund na urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mais portas significa busca mais longa. A lista de 1 a 1024 leva alguns segundos por dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mais portas significa uma pesquisa mais longa. A lista de 1 a 1024 demora alguns segundos por aparelho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mai multe porturi înseamnă o căutare mai lungă. Lista de la 1 la 1024 durează câteva secunde pe dispozitiv."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viac portov znamená dlhšie hľadanie. Zoznam 1 až 1024 trvá na zariadenie niekoľko sekúnd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fler portar innebär längre sökning. Listan med 1 till 1024 tar några sekunder per enhet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "端口越多，搜索越久。1 到 1024 的列表，每台设备需要几秒钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "連接埠越多，搜尋越久。1 到 1024 的清單，每部裝置需要數秒。"
          }
        }
      }
    },
