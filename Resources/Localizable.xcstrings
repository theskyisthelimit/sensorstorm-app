          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder de blote hemel duurt dat een paar seconden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod otwartym niebem zajmuje to kilka sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A céu aberto isso leva alguns segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
