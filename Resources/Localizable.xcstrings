    "Ohne Pro bleibt der CSV-Export jeder Aufnahme und jeder Route offen. Deine Messungen gehören dir, gekauft oder nicht." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون Pro يبقى تصدير CSV لكل تسجيل ولكل مسار مفتوحًا. قياساتك ملكك، اشتريت أم لا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Pro zůstává export do CSV každého záznamu a každé trasy otevřený. Vaše měření patří vám, koupeno nebo ne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden Pro er CSV-eksporten af hver optagelse og hver rute stadig åben. Dine målinger er dine, købt eller ej."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς Pro η εξαγωγή CSV κάθε εγγραφής και κάθε διαδρομής μένει ανοιχτή. Οι μετρήσεις σου είναι δικές σου, αγορασμένες ή όχι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without Pro the CSV export of every recording and every route stays open. Your measurements are yours, bought or not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin Pro, la exportación CSV de cada grabación y cada recorrido sigue abierta. Tus mediciones son tuyas, las compres o no."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman Pro:ta jokaisen tallenteen ja jokaisen reitin CSV-vienti pysyy avoimena. Mittauksesi ovat sinun, ostit tai et."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans Pro, l'export CSV de chaque enregistrement et de chaque parcours reste ouvert. Vos mesures vous appartiennent, achat ou pas."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Pro izvoz u CSV svake snimke i svake rute ostaje otvoren. Tvoja mjerenja su tvoja, kupljeno ili ne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro nélkül minden felvétel és minden útvonal CSV-exportálása nyitva marad. A méréseid a tieid, megvetted vagy sem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza Pro l'esportazione CSV di ogni registrazione e di ogni percorso resta aperta. Le tue misure sono tue, con o senza acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro がなくても、記録とルートの CSV 書き出しは常に使えます。あなたの測定値はあなたのものです。購入の有無にかかわらず。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro가 없어도 모든 기록과 모든 경로의 CSV 내보내기는 계속 열려 있습니다. 측정값은 구매 여부와 상관없이 당신의 것입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten Pro er CSV-eksporten av hvert opptak og hver rute fortsatt åpen. Målingene dine er dine, kjøpt eller ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder Pro blijft de CSV-export van elke opname en elke route open. Je metingen zijn van jou, gekocht of niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Pro eksport CSV każdego nagrania i każdej trasy pozostaje otwarty. Twoje pomiary należą do Ciebie, kupione czy nie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o Pro a exportação CSV de cada gravação e de cada percurso continua aberta. Suas medições são suas, com ou sem compra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem Pro, a exportação CSV de cada gravação e de cada percurso fica aberta. As tuas medições são tuas, compradas ou não."
