    "Erst lesen oder abonnieren, damit ein Wert da ist, an dem sich die Felder prüfen lassen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اقرأ أو اشترك أولًا لتتوفر قيمة يمكن فحص الحقول بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nejdřív čtěte nebo odebírejte, aby existovala hodnota, na které lze pole zkontrolovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Læs eller abonnér først, så der findes en værdi, som felterne kan kontrolleres mod."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διάβασε ή κάνε πρώτα συνδρομή ώστε να υπάρχει τιμή με την οποία να ελεγχθούν τα πεδία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Read or subscribe first so there is a value against which the fields can be checked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primero lee o suscríbete, para que haya un valor con el que comprobar los campos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lue tai tilaa ensin, jotta arvo on olemassa ja kenttiä voi tarkistaa sen avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisez ou abonnez-vous d’abord pour qu’une valeur soit disponible et permette de vérifier les champs."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prvo čitaj ili se pretplati kako bi postojala vrijednost na kojoj se mogu provjeriti polja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Előbb olvass vagy iratkozz fel, hogy legyen érték, amelyen a mezők ellenőrizhetők."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prima leggi o sottoscrivi, così c'è un valore su cui controllare i campi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "先に読み取るか購読して、フィールドを確認できる値を用意してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "필드를 확인할 값이 생기도록 먼저 읽거나 구독하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les eller abonner først, så det finnes en verdi feltene kan sjekkes mot."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
