          }
        }
      }
    },
    "Misst mit Ultrabreitband Abstand und Richtung zu einem zweiten iPhone, auf Zentimeter genau. Beide Telefone brauchen Ultrabreitband und die Verbindung unter „Bluetooth-Dienst und zweites iPhone“." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomocí ultraširokého pásma měří vzdálenost a směr k druhému iPhonu s přesností na centimetry. Oba telefony potřebují ultraširoké pásmo a spojení v části „Služba Bluetooth a druhý iPhone“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler med ultrabredbånd afstand og retning til en anden iPhone, centimeternøjagtigt. Begge telefoner kræver ultrabredbånd og forbindelsen under »Bluetooth-tjeneste og anden iPhone«."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses ultra-wideband to measure distance and direction to a second iPhone, accurate to the centimetre. Both phones need ultra-wideband and the connection under “Bluetooth service and second iPhone”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mide con banda ultraancha la distancia y la dirección a un segundo iPhone, con precisión de centímetros. Ambos teléfonos necesitan banda ultraancha y la conexión de «Servicio Bluetooth y segundo iPhone»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mesure avec l’ultra-large bande la distance et la direction vers un deuxième iPhone, au centimètre près. Les deux téléphones ont besoin de l’ultra-large bande et de la connexion sous « Service Bluetooth et deuxième iPhone »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Misura con la banda ultralarga distanza e direzione verso un secondo iPhone, con precisione al centimetro. Entrambi i telefoni richiedono la banda ultralarga e la connessione in «Servizio Bluetooth e secondo iPhone»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "超広帯域で 2 台目の iPhone までの距離と方向を、センチメートル単位の精度で測定します。両方の iPhone が超広帯域に対応している必要があり、「Bluetooth サービスと 2 台目の iPhone」での接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "초광대역으로 두 번째 iPhone까지의 거리와 방향을 센티미터 단위로 측정해요. 두 휴대폰 모두 초광대역이 필요하고 “Bluetooth 서비스와 두 번째 iPhone” 아래에서 연결돼 있어야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler med ultrabredbånd avstand og retning til en annen iPhone, centimeternøyaktig. Begge telefonene trenger ultrabredbånd og tilkoblingen under «Bluetooth-tjeneste og en annen iPhone»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meet met ultrabreedband afstand en richting tot een tweede iPhone, tot op de centimeter nauwkeurig. Beide telefoons hebben ultrabreedband nodig en de verbinding onder ‘Bluetooth-dienst en tweede iPhone’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mierzy za pomocą ultraszerokiego pasma odległość i kierunek do drugiego iPhone’a, z dokładnością do centymetra. Oba telefony potrzebują ultraszerokiego pasma i połączenia w „Usługa Bluetooth i drugi iPhone”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mede com banda ultralarga a distância e a direção até um segundo iPhone, com precisão de centímetros. Os dois celulares precisam de banda ultralarga e da conexão em “Serviço Bluetooth e segundo iPhone”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mede com banda ultralarga a distância e a direção a um segundo iPhone, com exatidão ao centímetro. Os dois telemóveis precisam de banda ultralarga e da ligação em «Serviço Bluetooth e segundo iPhone»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Măsoară cu ultra-wideband distanța și direcția către un al doilea iPhone, cu precizie de centimetri. Ambele telefoane au nevoie de ultra-wideband și de conexiunea de la „Serviciu Bluetooth și al doilea iPhone”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meria ultraširokopásmovým rádiom vzdialenosť a smer k druhému iPhonu, s presnosťou na centimetre. Oba telefóny potrebujú ultraširokopásmové rádio a spojenie v časti „Služba Bluetooth a druhý iPhone“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mäter avstånd och riktning till en annan iPhone med ultrabredband, med centimeters noggrannhet. Båda telefonerna behöver ultrabredband och anslutningen under ”Bluetooth-tjänst och en annan iPhone”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "用超宽带测量与第二台 iPhone 之间的距离和方向，精确到厘米。两部手机都需要超宽带，并需要在“蓝牙服务和第二台 iPhone”中建立连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "利用超寬頻量測與第二支 iPhone 之間的距離與方向，精確到公分。兩支手機都需要超寬頻，並在「藍牙服務與第二支 iPhone」中建立連線。"
          }
        }
      }
    },
    "Misst mit dem LiDAR den Abstand zur Bildmitte, bis etwa fünf Meter. Braucht ein Gerät mit LiDAR und die Aufnahme mit ARKit." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pomocí LiDARu měří vzdálenost ke středu obrazu, do zhruba pěti metrů. Vyžaduje zařízení s LiDAR a záznam s ARKit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler med LiDAR afstanden til billedets midte, op til omkring fem meter. Kræver en enhed med LiDAR og en optagelse med ARKit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses LiDAR to measure the distance to the image centre, up to about five metres. Needs a device with LiDAR and a recording with ARKit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mide con el LiDAR la distancia al centro de la imagen, hasta unos cinco metros. Requiere un dispositivo con LiDAR y la grabación con ARKit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mesure avec le LiDAR la distance au centre de l’image, jusqu’à environ cinq mètres. Nécessite un appareil avec LiDAR et un enregistrement avec ARKit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Misura con il LiDAR la distanza dal centro dell'immagine, fino a circa cinque metri. Richiede un dispositivo con LiDAR e la registrazione con ARKit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "LiDAR で画像中央までの距離を約 5 m まで測定します。LiDAR 搭載の端末と、ARKit での記録が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "LiDAR로 이미지 중앙까지의 거리를 약 5 m까지 측정해요. LiDAR가 있는 기기와 ARKit으로 하는 기록이 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler avstanden til bildesenteret med LiDAR, opptil omtrent fem meter. Krever en enhet med LiDAR og opptak med ARKit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meet met de LiDAR de afstand tot het midden van het beeld, tot ongeveer vijf meter. Vereist een apparaat met LiDAR en de opname met ARKit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mierzy za pomocą LiDAR odległość do środka obrazu, do około pięciu metrów. Wymaga urządzenia z LiDAR i nagrania z ARKit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mede com o LiDAR a distância até o centro da imagem, até uns cinco metros. Precisa de um aparelho com LiDAR e de gravação com ARKit."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mede com o LiDAR a distância ao centro da imagem, até cerca de cinco metros. Precisa de um aparelho com LiDAR e de uma gravação com ARKit."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Măsoară cu LiDAR distanța până la centrul imaginii, până la aproximativ cinci metri. Necesită un dispozitiv cu LiDAR și înregistrarea cu ARKit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meria LiDARom vzdialenosť k stredu snímky, do asi piatich metrov. Vyžaduje zariadenie s LiDAR a záznam s ARKit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mäter med LiDAR avståndet till bildmitten, upp till cirka fem meter. Kräver en enhet med LiDAR och en inspelning med ARKit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "用 LiDAR 测量到画面中心的距离，最远约五米。需要带 LiDAR 的设备，并且使用 ARKit 记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "用 LiDAR 量測到畫面中央的距離，最遠約五公尺。需要配備 LiDAR 的裝置，且記錄須使用 ARKit。"
          }
        }
      }
    },
    "Misst, wie schnell das Telefon aus dem Internet lädt und dorthin sendet, und wie stark sich die Antwortzeit verschlechtert, solange die Leitung voll ist. Vier Verbindungen, je acht Sekunden. Standardmässig gegen die öffentlichen Messpunkte von Cloudflare; das verbraucht Datenvolumen." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Měří, jak rychle telefon stahuje z internetu a odesílá do něj a jak moc se zhorší doba odezvy, dokud je linka plná. Čtyři spojení po osmi sekundách. Standardně proti veřejným měřicím bodům Cloudflare; spotřebovává datový objem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler, hvor hurtigt telefonen henter fra internettet og sender dertil, og hvor meget svartiden forværres, mens linjen er fuld. Fire forbindelser, hver otte sekunder. Som standard mod Cloudflares offentlige målepunkter. Det bruger data."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Measures how fast the phone downloads from the internet and uploads to it, and how much the response time worsens while the line is full. Four connections, eight seconds each. By default against Cloudflare’s public measurement points; this uses data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mide a qué velocidad descarga el teléfono desde Internet y envía hacia allí, y cuánto empeora el tiempo de respuesta mientras la línea está llena. Cuatro conexiones, ocho segundos cada una. Por defecto contra los puntos de medición públicos de Cloudflare; eso consume datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mesure la vitesse à laquelle le téléphone télécharge depuis Internet et envoie vers Internet, et de combien le temps de réponse se dégrade tant que la ligne est saturée. Quatre connexions, huit secondes chacune. Par défaut vers les points de mesure publics de Cloudflare ; cela consomme des données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Misura quanto velocemente il telefono scarica da Internet e vi invia dati, e quanto peggiora il tempo di risposta mentre la linea è piena. Quattro connessioni, otto secondi ciascuna. Per impostazione predefinita verso i punti di misura pubblici di Cloudflare; consuma traffico dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone がインターネットからダウンロードする速度とアップロードする速度、および回線が埋まっている間に応答時間がどれだけ悪化するかを測定します。4 本の接続を各 8 秒間使います。既定では Cloudflare の公開測定ポイントを使うため、データ通信量を消費します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "휴대폰이 인터넷에서 내려받고 올리는 속도, 회선이 가득 찼을 때 응답 시간이 얼마나 나빠지는지 측정해요. 연결 4개, 각 8초. 기본값은 Cloudflare의 공개 측정 지점이며 데이터를 사용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler hvor fort telefonen laster ned fra internett og sender dit, og hvor mye svartiden forverres mens linjen er full. Fire tilkoblinger, åtte sekunder hver. Som standard mot Cloudflares offentlige målepunkter; det bruker datavolum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meet hoe snel de telefoon van internet downloadt en ernaartoe uploadt, en hoeveel de reactietijd verslechtert zolang de lijn vol is. Vier verbindingen, elk acht seconden. Standaard tegen de openbare meetpunten van Cloudflare; dat verbruikt datavolume."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mierzy, jak szybko telefon pobiera z internetu i wysyła do niego, oraz jak bardzo pogarsza się czas odpowiedzi, gdy łącze jest zapełnione. Cztery połączenia, po osiem sekund. Domyślnie względem publicznych punktów pomiarowych Cloudflare; zużywa to pakiet danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mede a velocidade com que o celular baixa da internet e envia para ela, e quanto o tempo de resposta piora enquanto a linha está cheia. Quatro conexões, oito segundos cada. Por padrão contra os pontos de medição públicos da Cloudflare; isso consome dados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mede a velocidade a que o telemóvel descarrega da Internet e envia para lá, e quanto piora o tempo de resposta enquanto a linha está cheia. Quatro ligações, oito segundos cada. Por predefinição contra os pontos de medição públicos da Cloudflare; isto consome dados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Măsoară cât de repede descarcă telefonul din internet și cât de repede încarcă spre el, precum și cât de mult se degradează timpul de răspuns cât timp linia este ocupată. Patru conexiuni, câte opt secunde. Implicit față de punctele publice de măsurare ale Cloudflare; asta consumă date."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meria, ako rýchlo telefón preberá dáta z internetu a odosiela ich tam a o koľko sa zhorší čas odozvy, kým je linka plná. Štyri spojenia po osem sekúnd. Štandardne voči verejným meracím bodom Cloudflare; spotrebúva sa objem dát."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mäter hur snabbt telefonen laddar ned från internet och skickar dit, och hur mycket svarstiden försämras medan förbindelsen är fullt belastad. Fyra anslutningar, åtta sekunder var. Som standard mot Cloudflares offentliga mätpunkter; det förbrukar datavolym."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "测量手机从互联网下载和上传的速度，以及线路占满时响应时间会恶化多少。四个连接，每个八秒。默认使用 Cloudflare 的公共测量点；这会消耗流量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "量測手機從網際網路下載與上傳的速度，以及線路被占滿時回應時間惡化多少。四條連線，各八秒。預設對 Cloudflare 的公開量測點進行；這會消耗數據流量。"
          }
        }
      }
    },
