    "Schätzt die Helligkeit der Umgebung aus dem Kamerabild, in Lumen. Eine Schätzung, kein Luxmeter. Braucht die Aufnahme mit ARKit." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhaduje jas okolí z obrazu fotoaparátu, v lumenech. Je to odhad, ne luxmetr. Vyžaduje záznam s ARKit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skønner omgivelsernes lysstyrke ud fra kamerabilledet, i lumen. Et skøn, ikke en luxmeter. Kræver en optagelse med ARKit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estimates the brightness of the surroundings from the camera image, in lumens. An estimate, not a lux meter. Needs a recording with ARKit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estima el brillo del entorno a partir de la imagen de la cámara, en lúmenes. Una estimación, no un luxómetro. Requiere la grabación con ARKit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estime la luminosité de l’environnement à partir de l’image de la caméra, en lumens. Une estimation, pas un luxmètre. Nécessite un enregistrement avec ARKit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stima la luminosità dell'ambiente dall'immagine della fotocamera, in lumen. Una stima, non un luxmetro. Richiede la registrazione con ARKit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "カメラ画像から周囲の明るさをルーメンで推定します。推定値であり、照度計ではありません。ARKit での記録が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "카메라 영상으로 주변 밝기를 루멘 단위로 추정해요. 추정값이며 조도계가 아니에요. ARKit으로 하는 기록이 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anslår lysstyrken i omgivelsene fra kamerabildet, i lumen. Et anslag, ikke en luksmeter. Krever opptak med ARKit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schat de helderheid van de omgeving uit het camerabeeld, in lumen. Een schatting, geen luxmeter. Vereist de opname met ARKit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szacuje jasność otoczenia na podstawie obrazu z aparatu, w lumenach. Szacunek, nie luksomierz. Wymaga nagrania z ARKit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estima o brilho do ambiente a partir da imagem da câmera, em lúmens. Uma estimativa, não um luxímetro. Precisa de gravação com ARKit."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estima o brilho do ambiente a partir da imagem da câmara, em lúmen. Uma estimativa, não um luxímetro. Precisa de uma gravação com ARKit."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estimează luminozitatea mediului din imaginea camerei, în lumeni. O estimare, nu un luxmetru. Necesită înregistrarea cu ARKit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhaduje jas okolia z obrazu fotoaparátu, v lúmenoch. Odhad, nie luxmeter. Vyžaduje záznam s ARKit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uppskattar omgivningens ljusstyrka ur kamerabilden, i lumen. En uppskattning, ingen luxmätare. Kräver inspelning med ARKit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "根据相机画面估算周围环境的亮度，单位流明。这是估算值，不是照度计。需要使用 ARKit 记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "根據相機影像估算周圍的亮度，單位為流明。這是估算值，不是照度計。記錄須使用 ARKit。"
          }
        }
