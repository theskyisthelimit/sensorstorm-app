    "Zur Aufnahme %@ erfasst. Die Beobachtungen liegen auf derselben Uhr wie deren Sensordaten." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سُجِّل مع التسجيل %@. الملاحظات على الساعة نفسها التي لبيانات مستشعراته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenáno k záznamu %@. Pozorování leží na stejných hodinách jako jeho data senzorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registreret til optagelsen %@. Observationerne ligger på samme ur som dens sensordata."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταγράφηκε στην εγγραφή %@. Οι παρατηρήσεις βρίσκονται στο ίδιο ρολόι με τα δεδομένα αισθητήρων της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captured with recording %@. The observations sit on the same clock as its sensor data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrado con la grabación %@. Las observaciones están en el mismo reloj que sus datos de sensores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjattu tallenteeseen %@. Havainnot ovat samalla kellolla kuin sen anturidata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisi avec l’enregistrement %@. Les observations sont sur la même horloge que ses données de capteurs."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabilježeno uz snimku %@. Opažanja leže na istom satu kao njezini podaci senzora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ felvételhez rögzítve. Az észlelések ugyanazon az órán állnak, mint annak érzékelőadatai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevato con la registrazione %@. Le osservazioni sono sullo stesso orologio dei suoi dati dei sensori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録 %@ で取得しました。観測点はそのセンサーデータと同じ時計上にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록 %@에서 수집했어요. 관측은 그 센서 데이터와 같은 시계 위에 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrert til opptaket %@. Observasjonene ligger på samme klokke som sensordataene i det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgelegd bij opname %@. De waarnemingen liggen op dezelfde klok als de sensordata daarvan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane do nagrania %@. Obserwacje leżą na tym samym zegarze co jego dane czujników."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrado com a gravação %@. As observações estão no mesmo relógio que os dados de sensores dela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registado com a gravação %@. As observações estão no mesmo relógio que os seus dados de sensores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrată la înregistrarea %@. Observațiile stau pe același ceas ca datele ei de senzori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записано к записи %@. Наблюдения лежат на тех же часах, что и её данные датчиков."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenané k záznamu %@. Pozorovania ležia na tých istých hodinách ako jeho dáta senzorov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
