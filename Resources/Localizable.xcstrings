    "Die Funktechnik, mit der das Telefon gerade verbunden ist. Netzbetreiber, Zellen-ID und Signalstärke gibt iOS an Apps nicht heraus." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقنية الاتصال اللاسلكي المتصل بها الهاتف حاليًا. لا يوفّر iOS للتطبيقات اسم المشغّل ولا معرّف الخلية ولا قوة الإشارة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rádiová technologie, ke které je telefon právě připojen. Operátora, ID buňky a sílu signálu iOS aplikacím nevydává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den radioteknologi, telefonen er forbundet med lige nu. Teleudbyder, celle-id og signalstyrke udleverer iOS ikke til apps."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η ασύρματη τεχνολογία με την οποία είναι συνδεδεμένο αυτή τη στιγμή το τηλέφωνο. Τον πάροχο, το αναγνωριστικό κυψέλης και την ισχύ σήματος το iOS δεν τα δίνει στις εφαρμογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The radio technology the phone is currently connected with. iOS does not give apps the carrier, cell ID or signal strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tecnología de radio a la que está conectado ahora el teléfono. iOS no entrega a las apps el operador, el ID de celda ni la intensidad de señal."
