        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sem essa permissão, nada na própria rede responde. Ative em Ajustes, em “Privacidade e Segurança” → “Rede Local”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sem esta autorização, nada responde na própria rede. Ativa em Definições, em «Privacidade e segurança» → «Rede local»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fără această permisiune nu răspunde nimic în propria rețea. Activează în Configurări, la „Confidențialitate și securitate” → „Rețea locală”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez tohto povolenia vo vlastnej sieti nič neodpovedá. Zapnite ho v Nastaveniach v časti „Súkromie a zabezpečenie“ → „Lokálna sieť“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utan det här tillståndet svarar inget i det egna nätverket. Slå på det i Inställningar under ”Integritet och säkerhet” → ”Lokalt nätverk”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "没有这项授权，你自己网络中的任何设备都不会响应。请在“设置”的“隐私与安全性”→“本地网络”中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "沒有這項授權，自己網路中的任何裝置都不會回應。請在「設定」的「隱私權與安全性」→「本地網路」中開啟。"
          }
        }
      }
    },
