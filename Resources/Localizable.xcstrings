    "Die Antwortzeit steigt unter Last stark. Das deutet auf einen überfüllten Puffer im Router hin (Bufferbloat)." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doba odezvy při zátěži výrazně roste. To ukazuje na přeplněnou vyrovnávací paměť v routeru (bufferbloat)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svartiden stiger kraftigt under belastning. Det tyder på en overfyldt buffer i routeren (bufferbloat)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Response time rises sharply under load. This points to an overfull buffer in the router (bufferbloat)."
