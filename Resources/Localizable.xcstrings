          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For få fikser til en midling. Prøv igjen under åpen himmel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te weinig fixes voor een middeling. Probeer het opnieuw onder open hemel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za mało fixów do uśrednienia. Spróbuj ponownie pod otwartym niebem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
