    "Hält an der aktuellen Position eine Beobachtung fest, ohne die App zu öffnen. Für die Aktionstaste." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يسجّل ملاحظة عند الموقع الحالي دون فتح التطبيق. لزر الإجراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zaznamená pozorování na aktuální poloze, aniž byste otevřeli aplikaci. Pro tlačítko Akce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registrerer en observation på den aktuelle position uden at åbne appen. Til handlingsknappen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αποτυπώνει μια παρατήρηση στην τρέχουσα θέση χωρίς να ανοίξει η εφαρμογή. Για το κουμπί Δράσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Records an observation at the current position without opening the app. For the Action button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registra una observación en la posición actual sin abrir la app. Para el botón de acción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirjaa havainnon nykyiseen sijaintiin avaamatta sovellusta. Toimintopainiketta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consigne une observation à la position actuelle sans ouvrir l’app. Pour le bouton Action."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bilježi opažanje na trenutnom položaju bez otvaranja aplikacije. Za tipku Radnja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rögzít egy észlelést az aktuális pozíción az app megnyitása nélkül. A Műveletgombhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registra un'osservazione nella posizione attuale senza aprire l'app. Per il tasto Azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アプリを開かずに、現在位置の観測点を記録します。アクションボタン用です。"
          }
        },
