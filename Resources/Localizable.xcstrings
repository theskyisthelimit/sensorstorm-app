    "Vor der Einmündung, Kante scharf." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل الملتقى، الحافة حادة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před nájezdem, hrana ostrá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før udmundingen, kanten skarp."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν από τη συμβολή, ακμή κοφτερή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before the junction, sharp edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes del entronque, borde vivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen liittymää, reuna terävä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant le débouché, arête vive."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije priključka, rub oštar."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A becsatlakozás előtt, éles perem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima dell'innesto, bordo vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交差点手前、エッジが鋭い。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교차부 앞, 모서리가 날카로움."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før avkjørselen, kanten skarp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor de aansluiting, scherpe rand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed wlotem, krawędź ostra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes do entroncamento, borda viva."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes do entroncamento, borda viva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte de racord, muchia ascuțită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед примыканием, кромка острая."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred nájazdom, hrana ostrá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Före korsningen, kanten skarp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kavşaktan önce, kenar keskin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед примиканням, край гострий."
          }
