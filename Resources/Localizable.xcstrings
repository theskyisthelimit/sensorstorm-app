    "Die Route als GeoJSON für QGIS, als KML für Google Earth, als GPX zum Wiederfinden, oder als Bündel mit jedem Foto und Clip." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The route as GeoJSON for QGIS, as KML for Google Earth, as GPX to find the spot again, or as a bundle with every photo and clip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recorrido en GeoJSON para QGIS, en KML para Google Earth, en GPX para volver a encontrar el punto, o como paquete con cada foto y cada clip."
          }
        },
        "fr" : {
          "stringUnit" : {
