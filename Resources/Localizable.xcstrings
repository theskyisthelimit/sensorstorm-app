    "Kein Abo, keine Verlängerung, kein Konto." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا اشتراك، بلا تجديد، بلا حساب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez předplatného, bez obnovení, bez účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet abonnement, ingen fornyelse, ingen konto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς συνδρομή, χωρίς ανανέωση, χωρίς λογαριασμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No subscription, no renewal, no account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin suscripción, sin renovación, sin cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tilausta, ei uusimista, ei tiliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'abonnement, pas de reconduction, pas de compte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pretplate, bez obnove, bez računa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs előfizetés, nincs megújítás, nincs fiók."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun abbonamento, nessun rinnovo, nessun account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションなし、更新なし、アカウントなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독 없음, 갱신 없음, 계정 없음."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke abonnement, ingen fornyelse, ingen konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen abonnement, geen verlenging, geen account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez abonamentu, bez odnowienia, bez konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura, sem renovação, sem conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem subscrição, sem renovação, sem conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără abonament, fără reînnoire, fără cont."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без подписки, без продления, без учётной записи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez predplatného, bez obnovenia, bez účtu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen prenumeration, ingen förnyelse, inget konto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik yok, yenileme yok, hesap yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без підписки, без поновлення, без облікового запису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无订阅、无续期、无账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有訂閱、不會續約、不需帳號。"
          }
        }
      }
    },
    "Kein Bereich markiert." : {
      "localizations" : {
