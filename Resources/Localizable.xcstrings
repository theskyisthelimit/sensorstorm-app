        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每张影像记录位置、视线方向和焦距。有了这些，影像才能放到 3D 场景中它们所在的位置。"
          }
        },
        "zh-Hant" : {
