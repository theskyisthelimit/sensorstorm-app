        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "显示沿途的路由器。每一跳会发送三个生存时间递增的数据包；不响应的路由器显示为星号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
