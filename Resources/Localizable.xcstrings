        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímka každých 1,5 m. Pre prejdený chodník alebo ulicu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
