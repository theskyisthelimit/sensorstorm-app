    "Alle 1,5 m ein Bild. Für einen abgelaufenen Weg oder eine Strasse." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صورة كل 1٫5 m. لمسار مقطوع أو لشارع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímek každých 1,5 m. Pro prošlou cestu nebo ulici."
