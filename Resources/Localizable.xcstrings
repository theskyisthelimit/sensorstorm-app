    "Der Kauf wartet auf Freigabe. Sobald sie erteilt ist, schaltet sich Pro von selbst frei." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشراء ينتظر الموافقة. وحين تُمنح، يُفعَّل Pro من تلقاء نفسه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákup čeká na schválení. Jakmile bude uděleno, Pro se odemkne samo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet venter på godkendelse. Så snart den er givet, låser Pro op af sig selv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αγορά περιμένει έγκριση. Μόλις δοθεί, το Pro ξεκλειδώνει από μόνο του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase is waiting for approval. Pro unlocks itself as soon as it is granted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra está esperando aprobación. En cuanto llegue, Pro se desbloquea solo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osto odottaa hyväksyntää. Heti kun se on annettu, Pro avautuu itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'achat attend une autorisation. Dès qu'elle est donnée, Pro se débloque tout seul."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupnja čeka odobrenje. Čim ono stigne, Pro se otključava sam."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vásárlás jóváhagyásra vár. Amint megérkezik, a Pro magától feloldódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acquisto è in attesa di approvazione. Appena arriva, Pro si sblocca da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は承認待ちです。承認され次第、Pro は自動的に有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매가 승인을 기다리고 있습니다. 승인되면 Pro가 저절로 활성화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøpet venter på godkjenning. Så snart den er gitt, låser Pro opp av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aankoop wacht op goedkeuring. Zodra die er is, wordt Pro vanzelf vrijgegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakup czeka na zatwierdzenie. Gdy tylko zostanie udzielone, Pro odblokuje się samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compra está aguardando aprovação. Assim que ela vier, o Pro se libera sozinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compra aguarda aprovação. Assim que for dada, o Pro desbloqueia-se sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achiziția așteaptă aprobarea. Îndată ce este dată, Pro se deblochează singur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка ждёт подтверждения. Как только оно придёт, Pro разблокируется сам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákup čaká na schválenie. Hneď ako bude udelené, Pro sa odomkne samo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köpet väntar på godkännande. Så snart det ges låser Pro upp sig själv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alma onay bekliyor. Onay verilir verilmez Pro kendiliğinden açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка чекає на підтвердження. Щойно його нададуть, Pro розблокується сам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买正在等待批准。批准之后，Pro 会自行解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買正在等待核准。核准後 Pro 會自動啟用。"
          }
        }
      }
    },
