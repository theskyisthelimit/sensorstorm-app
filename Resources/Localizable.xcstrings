        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kis lépések: egy kép 10 centiméterenként. Olyasmihez, amit körbejársz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi piccoli: un’immagine ogni 10 cm. Per qualcosa attorno a cui si gira."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
