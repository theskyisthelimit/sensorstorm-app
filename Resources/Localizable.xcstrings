    "Alles auf dem Gerät als ein Zip mit manifest.json: jede Datei mit SHA-256, jede Beobachtung mit Position und Bewertung." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما على الجهاز في ملف zip واحد مع manifest.json: كل ملف مع SHA-256، وكل ملاحظة مع الموقع والخطورة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše ze zařízení jako jeden zip s manifest.json: každý soubor se SHA-256, každé pozorování s pozicí a závažností."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt på enheden som ét zip med manifest.json: hver fil med SHA-256, hver observation med position og alvorlighed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα όσα βρίσκονται στη συσκευή ως ένα zip με manifest.json: κάθε αρχείο με SHA-256, κάθε παρατήρηση με θέση και σοβαρότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything on the device as one zip with manifest.json: every file with its SHA-256, every observation with its position and severity."
