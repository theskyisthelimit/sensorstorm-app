    "Läuft, seit diese Ansicht offen ist. Die Aufnahme startet weiterhin auf der Hauptseite." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل منذ فتح هذا العرض. ويبدأ التسجيل كما كان من الشاشة الرئيسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běží od chvíle, kdy se toto zobrazení otevřelo. Nahrávání se stále spouští na hlavní obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører, siden denne visning blev åbnet. Optagelsen starter stadig på hovedskærmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρέχει από τότε που άνοιξε αυτή η προβολή. Η εγγραφή ξεκινά πάντα από την κύρια οθόνη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running since this view opened. The recording still starts on the main screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre desde que se abrió esta vista. La grabación sigue empezando en la pantalla principal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käy siitä asti kun tämä näkymä avattiin. Tallennus käynnistyy edelleen päänäkymästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne depuis l’ouverture de cette vue. L’enregistrement démarre toujours sur l’écran principal."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radi otkako je ovaj prikaz otvoren. Snimanje se i dalje pokreće na glavnom zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attól fut, hogy ez a nézet megnyílt. A felvétel továbbra is a főképernyőn indul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira da quando questa vista è aperta. La registrazione si avvia sempre dalla schermata principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面を開いてから動いています。録画の開始は引き続きメイン画面から行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 화면을 연 뒤로 계속 돌아가요. 기록 시작은 여전히 메인 화면에서 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går siden denne visningen ble åpnet. Opptaket startes fortsatt på hovedskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loopt sinds deze weergave open is. De opname start nog steeds op het hoofdscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa, odkąd ten widok jest otwarty. Nagrywanie nadal zaczyna się na ekranie głównym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda desde que esta tela foi aberta. A gravação continua começando na tela principal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre desde que este ecrã foi aberto. A gravação continua a começar no ecrã principal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulează de când s-a deschis această vizualizare. Înregistrarea tot de pe ecranul principal pornește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идёт с момента открытия этого экрана. Запись по-прежнему начинается на главном экране."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beží odvtedy, čo sa toto zobrazenie otvorilo. Nahrávanie sa stále spúšťa na hlavnej obrazovke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går sedan den här vyn öppnades. Inspelningen startar fortfarande på huvudskärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu görünüm açıldığından beri çalışıyor. Kayıt yine ana ekrandan başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триває відтоді, як відкрито цей екран. Запис і далі починається на головному екрані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
