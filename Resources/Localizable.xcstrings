        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "휴대폰이 지금 연결된 무선 기술이에요. 통신사, 셀 ID, 신호 세기는 iOS가 앱에 알려주지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Radioteknologien telefonen er koblet til akkurat nå. Operatør, celle-ID og signalstyrke gir iOS ikke fra seg til apper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De radiotechniek waarmee de telefoon nu verbonden is. Provider, cel-ID en signaalsterkte geeft iOS niet aan apps vrij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Technologia radiowa, z którą telefon jest aktualnie połączony. Operatora, identyfikatora komórki i siły sygnału iOS nie udostępnia aplikacjom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A tecnologia de rádio à qual o celular está conectado no momento. O iOS não informa aos apps a operadora, o ID da célula nem a intensidade do sinal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
