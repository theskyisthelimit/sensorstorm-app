    "Unter freiem Himmel dauert das ein paar Sekunden." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحت السماء المفتوحة يستغرق ذلك بضع ثوانٍ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod otevřeným nebem to trvá pár sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under åben himmel tager det et par sekunder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτω από ανοιχτό ουρανό αυτό παίρνει λίγα δευτερόλεπτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under open sky this takes a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cielo abierto tarda unos segundos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoimen taivaan alla se kestää muutaman sekunnin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À ciel ouvert, cela prend quelques secondes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod otvorenim nebom to traje nekoliko sekundi."
          }
        },
