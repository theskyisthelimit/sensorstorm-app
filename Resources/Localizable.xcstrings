          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ensimmäinen mittauksesi Tallenna-välilehdellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez votre première mesure depuis l'onglet « Enregistrer »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Započni prvo mjerenje na kartici „Snimaj“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdd az első mérésedet a „Felvétel” lapon."
          }
