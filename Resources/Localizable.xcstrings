    "Beliebig viele Begehungen nebeneinander — pro Strasse, pro Auftrag, pro Tag.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any number of surveys side by side — per street, per job, per day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autant de parcours en parallèle que vous voulez — par rue, par mandat, par jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti percorsi vuoi, in parallelo — per strada, per incarico, per giorno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantos recorridos en paralelo como quieras: por calle, por encargo, por día."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoveel rondes naast elkaar als je wilt — per straat, per opdracht, per dag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos percursos em paralelo você quiser — por rua, por serviço, por dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巡回はいくつでも並行して — 道路ごと、案件ごと、日ごとに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순회는 얼마든지 동시에 — 도로별, 건별, 날짜별로."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時進行任意多條巡查路線 — 依道路、依案件、依日期。"
