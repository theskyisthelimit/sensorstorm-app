          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zonder deze toestemming antwoordt er niets in het eigen netwerk. Schakel ‘Lokaal netwerk’ in via Instellingen onder ‘Privacy en beveiliging’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez tego zezwolenia nic w sieci własnej nie odpowiada. Włącz w Ustawieniach w „Prywatność i ochrona” → „Sieć lokalna”."
