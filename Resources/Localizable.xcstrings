    "Kleine Schritte: alle 10 cm ein Bild. Für etwas, das man umrundet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوات صغيرة: صورة كل 10 cm. لشيء يُدار حوله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malé kroky: snímek každých 10 cm. Pro něco, co se obchází dokola."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små skridt: et billede for hver 10 cm. Til noget, man går rundt om."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μικρά βήματα: μία εικόνα κάθε 10 cm. Για κάτι που το γυρίζεις ολόγυρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small steps: an image every 10 cm. For something you walk around."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasos pequeños: una imagen cada 10 cm. Para algo que se rodea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieniä askelia: kuva 10 senttimetrin välein. Kohteelle, jonka ympäri kierretään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petits pas : une image tous les 10 cm. Pour un objet que l'on contourne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mali koraci: snimka svakih 10 cm. Za nešto što se obilazi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kis lépések: egy kép 10 centiméterenként. Olyasmihez, amit körbejársz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi piccoli: un’immagine ogni 10 cm. Per qualcosa attorno a cui si gira."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小刻みに、10 cm ごとに 1 枚。周囲を回って撮る対象向け。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 보폭으로 10 cm마다 한 장. 둘러가며 찍는 대상에 적합합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små skritt: ett bilde hver 10 cm. For noe man går rundt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine stappen: elke 10 cm een beeld. Voor iets waar je omheen loopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe kroki: zdjęcie co 10 cm. Do czegoś, co się obchodzi dookoła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passos curtos: uma imagem a cada 10 cm. Para algo que se contorna."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
