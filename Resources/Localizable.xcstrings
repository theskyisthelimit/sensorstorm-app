          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un percorso raccoglie osservazioni lungo un tragitto. Per osservazione: quante foto e clip vuoi, la posizione con la sua incertezza, una gravità da 1 a 10 e l'area marcata."
          }
        },
        "ja" : {
          "stringUnit" : {
