    "Die Aufnahme als .ssbin, verlustfrei und in voller Auflösung, statt gerundet in CSV." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording as .ssbin, lossless and at full resolution, rather than rounded into CSV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación en .ssbin, sin pérdidas y a resolución completa, en vez de redondeada en CSV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement en .ssbin, sans perte et à pleine résolution, plutôt qu'arrondi en CSV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione in .ssbin, senza perdita e a piena risoluzione, invece che arrotondata in CSV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録を .ssbin で。CSV に丸めるのではなく、可逆かつ完全な分解能のまま。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 .ssbin으로. CSV로 반올림하는 대신 무손실에 온전한 해상도로."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname als .ssbin, verliesvrij en op volle resolutie, in plaats van afgerond in CSV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação em .ssbin, sem perdas e em resolução plena, em vez de arredondada em CSV."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A gravação como .ssbin, sem perdas e em resolução total, em vez de arredondada em CSV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запись как .ssbin, без потерь и в полном разрешении, а не округлённой в CSV."
          }
