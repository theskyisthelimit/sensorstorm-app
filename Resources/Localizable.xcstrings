          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles op het apparaat als één ZIP met manifest.json: elk bestand met zijn SHA-256, elk geval met positie en ernst."
          }
        },
        "pt-BR": {
          "stringUnit": {
