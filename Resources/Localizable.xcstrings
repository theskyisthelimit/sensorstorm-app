          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la carte pour déplacer le centre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni kartu da pomakneš središte."
          }
