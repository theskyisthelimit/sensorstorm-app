    "Für ein eigenes Dashboard, Node-RED oder Home Assistant. Ohne eingetragene Adresse baut die App keine Verbindung auf." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your own dashboard, Node-RED or Home Assistant. With no address entered, the app opens no connection at all."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para tu propio panel, Node-RED o Home Assistant. Sin una dirección introducida, la app no abre ninguna conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour votre propre tableau de bord, Node-RED ou Home Assistant. Sans adresse saisie, l'app n'ouvre aucune connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
