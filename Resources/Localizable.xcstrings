    "Setzt eine Notiz in die laufende Aufnahme, auf die gemeinsame Uhr aller Sensoren." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vloží poznámku do probíhajícího záznamu, na společné hodiny všech senzorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sætter en note i den igangværende optagelse, på alle sensorers fælles ur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adds a note to the running recording, on the shared clock of all sensors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade una nota a la grabación en curso, en el reloj común de todos los sensores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pose une note dans l’enregistrement en cours, sur l’horloge commune de tous les capteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inserisce una nota nella registrazione in corso, sull'orologio comune di tutti i sensori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべてのセンサーに共通の時計で、実行中の記録にメモを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "진행 중인 기록에 메모를 추가해요. 모든 센서가 공유하는 시계에 맞춰져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Legger inn et notat i det pågående opptaket, på den felles klokken til alle sensorer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zet een notitie in de lopende opname, op de gemeenschappelijke klok van alle sensoren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wstawia notatkę do trwającego nagrania, na wspólnym zegarze wszystkich czujników."
          }
