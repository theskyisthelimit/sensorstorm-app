    "Schalte oben die Kamera ein. Ohne Bild gibt es keine Kamerapose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الكاميرا في الأعلى. بلا صورة لا توجد وضعية كاميرا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte nahoře fotoaparát. Bez obrazu není póza kamery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tænd kameraet foroven. Uden billede er der ingen kamerapose."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άναψε την κάμερα επάνω. Χωρίς εικόνα δεν υπάρχει πόζα κάμερας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch the camera on above. Without an image there is no camera pose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la cámara arriba. Sin imagen no hay pose de cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytke kamera päälle ylhäältä. Ilman kuvaa ei ole kamera-asentoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la caméra en haut. Sans image, pas de pose de caméra."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključi kameru gore. Bez slike nema poze kamere."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be fent a kamerát. Kép nélkül nincs kamerapóz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la fotocamera in alto. Senza immagine non c’è posa della fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上でカメラをオンにしてください。画像がなければカメラポーズもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에서 카메라를 켜세요. 이미지가 없으면 카메라 포즈도 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
