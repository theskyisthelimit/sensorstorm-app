          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyílt ég alatt ez néhány másodpercig tart."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cielo aperto ci vogliono pochi secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋外なら数秒で完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탁 트인 하늘 아래에서는 몇 초면 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under åpen himmel tar det noen sekunder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder de blote hemel duurt dat een paar seconden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod otwartym niebem zajmuje to kilka sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A céu aberto isso leva alguns segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
