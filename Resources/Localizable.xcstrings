          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tracciato è stato percorso tra %@ e %@ ed è riportato sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
