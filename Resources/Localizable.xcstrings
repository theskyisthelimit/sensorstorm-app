        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімки несуть фокусну відстань, місце та час в EXIF. Поруч лежать таблиця камер і модель COLMAP. Модель 3D обчислюють RealityScan, Metashape або Meshroom. Цей застосунок її не обчислює."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影像在 EXIF 中带有焦距、地点和时间。旁边是相机表和 COLMAP 模型。3D 模型由 RealityScan、Metashape 或 Meshroom 计算，本 App 不做计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影像在 EXIF 中帶有焦距、地點與時間。旁邊是相機表與 COLMAP 模型。3D 模型由 RealityScan、Metashape 或 Meshroom 計算，本 App 不做計算。"
          }
        }
      }
    },
    "Die Bildstabilisierung bleibt aus, damit das Bild exakt zu den Bewegungsdaten passt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى تثبيت الصورة معطّلًا كي تطابق الصورة بيانات الحركة تمامًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilizace obrazu zůstává vypnutá, aby obraz přesně odpovídal datům pohybu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billedstabiliseringen forbliver slået fra, så billedet passer nøjagtigt til bevægelsesdataene."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σταθεροποίηση εικόνας μένει απενεργοποιημένη, ώστε η εικόνα να ταιριάζει ακριβώς με τα δεδομένα κίνησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video stabilisation stays off so the image lines up exactly with the motion data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estabilización permanece apagada para que la imagen coincida exactamente con los datos de movimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvanvakautus pysyy pois päältä, jotta kuva vastaa tarkasti liikedataa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stabilisation reste désactivée pour que l'image corresponde exactement aux données de mouvement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilizacija slike ostaje isključena, da slika točno odgovara podacima kretanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képstabilizálás kikapcsolva marad, hogy a kép pontosan illeszkedjen a mozgásadatokhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stabilizzazione resta disattivata perché l'immagine corrisponda esattamente ai dati di movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像とモーションデータが正確に対応するよう、手ぶれ補正はオフのままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상과 모션 데이터가 정확히 맞도록 손떨림 보정은 꺼둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildestabiliseringen forblir av, slik at bildet passer nøyaktig til bevegelsesdataene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De beeldstabilisatie blijft uit, zodat het beeld exact bij de bewegingsdata past."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilizacja obrazu pozostaje wyłączona, żeby obraz dokładnie pasował do danych ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estabilização permanece desligada para que a imagem corresponda exatamente aos dados de movimento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estabilização de imagem fica desligada, para que a imagem coincida exatamente com os dados de movimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilizarea imaginii rămâne oprită, ca imaginea să se potrivească exact cu datele de mișcare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стабилизация изображения остаётся выключенной, чтобы картинка точно совпадала с данными движения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilizácia obrazu zostáva vypnutá, aby obraz presne zodpovedal dátam pohybu."
