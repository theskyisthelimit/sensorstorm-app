          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上のすべてを manifest.json 付きの ZIP で。各ファイルに SHA-256、各事案に位置と深刻度。"
          }
        },
        "ko": {
          "stringUnit": {
