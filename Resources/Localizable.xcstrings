          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条路线的所有观测点、照片和片段都会被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此路線的所有觀測點、照片與影片都會被移除。"
          }
        }
      }
    },
