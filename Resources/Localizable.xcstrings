    "Alle Beobachtungen, Fotos und Clips dieser Route werden entfernt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف كل الملاحظات والصور والمقاطع في هذا المسار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna pozorování, fotky a klipy této trasy budou odstraněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle observationer, fotos og klip på denne rute fjernes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι παρατηρήσεις, οι φωτογραφίες και τα κλιπ αυτής της διαδρομής θα αφαιρεθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every observation, photo and clip in this route will be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos las observaciones, fotos y vídeos de este recorrido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tämän reitin havainnot, kuvat ja klipit poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les observations, photos et vidéos de ce parcours seront supprimés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sva opažanja, fotografije i isječci ove rute bit će uklonjeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az útvonal összes észlelése, fotója és klipje törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti le osservazioni, le foto e i video di questo percorso verranno rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルートのすべての観測点、写真、動画が削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 경로의 모든 관측, 사진, 동영상이 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle observasjoner, foto og klipp på denne ruten fjernes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle waarnemingen, foto's en clips van deze route worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie obserwacje, zdjęcia i klipy tej trasy zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos as observações, fotos e clipes deste percurso serão removidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as observações, fotos e clipes deste percurso serão removidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate observațiile, fotografiile și clipurile acestui traseu vor fi eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все наблюдения, фото и клипы этого маршрута будут удалены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky pozorovania, fotky a klipy tejto trasy sa odstránia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla observationer, foton och klipp i den här rutten tas bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu rotanın tüm gözlemleri, fotoğrafları ve klipleri kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
