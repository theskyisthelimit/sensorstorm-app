    "Die Aufnahme als .ssbin, verlustfrei und in voller Auflösung, statt gerundet in CSV.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording as .ssbin, lossless and at full resolution, rather than rounded into CSV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement en .ssbin, sans perte et à pleine résolution, plutôt qu'arrondi en CSV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione in .ssbin, senza perdita e a piena risoluzione, invece che arrotondata in CSV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación en .ssbin, sin pérdidas y a resolución completa, en vez de redondeada en CSV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname als .ssbin, verliesvrij en op volle resolutie, in plaats van afgerond in CSV."
          }
        }
      }
    },
    "Die Begehung als GeoJSON für QGIS, als KML für Google Earth, als GPX zum Wiederfinden, oder als Bündel mit jedem Foto und Clip.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The survey as GeoJSON for QGIS, as KML for Google Earth, as GPX to find the spot again, or as a bundle with every photo and clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parcours en GeoJSON pour QGIS, en KML pour Google Earth, en GPX pour retrouver l'endroit, ou en ensemble avec chaque photo et chaque clip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso in GeoJSON per QGIS, in KML per Google Earth, in GPX per ritrovare il punto, o come pacchetto con ogni foto e ogni clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recorrido en GeoJSON para QGIS, en KML para Google Earth, en GPX para volver a encontrar el punto, o como paquete con cada foto y cada clip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ronde als GeoJSON voor QGIS, als KML voor Google Earth, als GPX om de plek terug te vinden, of als bundel met elke foto en elke clip."
          }
        }
      }
    },
    "Die Bildstabilisierung bleibt aus, damit das Bild exakt zu den Bewegungsdaten passt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video stabilisation stays off so the image lines up exactly with the motion data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La stabilisation reste désactivée pour que l'image corresponde exactement aux données de mouvement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stabilizzazione resta disattivata perché l'immagine corrisponda esattamente ai dati di movimento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estabilización permanece apagada para que la imagen coincida exactamente con los datos de movimiento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beeldstabilisatie blijft uit, zodat het beeld exact bij de bewegingsdata past."
          }
        }
      }
    },
    "Die Daten bleiben in der Aufnahme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data stays in the recording"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données restent dans l'enregistrement"
          }
