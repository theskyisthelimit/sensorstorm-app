        }
      }
    },
    "Die laufende Aufnahme benutzt die Kamera. Beobachtung ohne Foto erfassen oder die Aufnahme stoppen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
