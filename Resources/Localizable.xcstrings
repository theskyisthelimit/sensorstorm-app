    "Position wird gesucht … Ohne Fix oder gesetzte Nadel lässt sich die Beobachtung nicht sichern." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ البحث عن الموقع … بدون نقطة GPS أو دبوس موضوع لا يمكن حفظ الملاحظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledá se pozice … Bez fixu nebo umístěného špendlíku nelze pozorování uložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søger position … Uden fix eller sat nål kan observationen ikke gemmes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζήτηση θέσης … Χωρίς στίγμα ή τοποθετημένη πινέζα η παρατήρηση δεν αποθηκεύεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding your position … Without a fix or a placed pin the observation cannot be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando la posición … Sin fix ni chincheta puesta, la observación no se puede guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haetaan sijaintia … Ilman fixiä tai asetettua nuppineulaa havaintoa ei voi tallentaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de la position … Sans point GPS ni épingle posée, l'observation ne peut pas être enregistré."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traži se položaj … Bez fixa ili postavljene pribadače opažanje se ne može spremiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helyzet keresése … Fix vagy elhelyezett tű nélkül az észlelés nem menthető."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca della posizione … Senza fix o spillo posato l'osservazione non può essere salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置を取得中 … フィックスもピンもない状態では観測点を保存できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 찾는 중 … 픽스도 핀도 없으면 관측를 저장할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søker posisjon … Uten fiks eller satt nål kan observasjonen ikke lagres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positie wordt gezocht … Zonder fix of geplaatste speld kan de waarneming niet worden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukanie pozycji … Bez fixa albo ustawionej pinezki obserwacji nie da się zapisać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurando a posição … Sem fix nem alfinete colocado, a observação não pode ser salvo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A procurar posição … Sem fix ou alfinete colocado não é possível guardar a observação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se caută poziția … Fără fix sau pioneză pusă, observația nu poate fi salvată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идёт поиск позиции … Без фикса или поставленной булавки наблюдение не сохранить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hľadá sa pozícia … Bez fixu alebo umiestneného špendlíka sa pozorovanie nedá uložiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker position … Utan fix eller satt nål går observationen inte att spara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum aranıyor … Sabitleme ya da konmuş iğne olmadan gözlem kaydedilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук позиції … Без фікса або поставленої шпильки спостереження не зберегти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
