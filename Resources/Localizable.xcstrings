    "Beliebig viele Routen nebeneinander: pro Strasse, pro Auftrag, pro Tag." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As many routes as you like, side by side: per street, per job, per day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tantos recorridos como quieras, uno junto a otro: por calle, por encargo, por día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autant de parcours que vous voulez, côte à côte : par rue, par mandat, par jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanti percorsi vuoi, affiancati: per strada, per incarico, per giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ルートはいくつでも並行して作れます：道路ごと、案件ごと、日ごと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "경로는 원하는 만큼 나란히 둘 수 있어요: 도로별, 작업별, 날짜별."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zoveel routes naast elkaar als je wilt: per straat, per opdracht, per dag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quantos percursos você quiser, lado a lado: por rua, por serviço, por dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
