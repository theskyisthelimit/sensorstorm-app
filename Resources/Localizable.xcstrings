    "Fernzugriff auf die Kommandozeile ohne Verschlüsselung. Abschalten oder durch SSH ersetzen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وصول عن بُعد إلى سطر الأوامر بدون تشفير. أوقفه أو استبدله بـ SSH."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
