            "value" : "Profiili asettaa anturit, taajuuden ja katalogin. Kaikkea voi sen jälkeen muuttaa yksitellen, ja profiilia voi vaihtaa milloin tahansa Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
