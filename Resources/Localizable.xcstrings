    "Freier Speicher und Lautstärke der Audio-Route. Erklärt Aussetzer, wenn der Speicher voll läuft oder ein Mikrofon abgezogen wird." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volné místo a hlasitost zvukové trasy. Vysvětluje výpadky, když dojde místo nebo se odpojí mikrofon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ledig plads og lydstyrke på lydroutingen. Forklarer udfald, når pladsen løber fuld, eller en mikrofon trækkes ud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Free storage and volume of the audio route. Explains dropouts when storage fills up or a microphone is unplugged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espacio libre y volumen de la ruta de audio. Explica los cortes cuando el almacenamiento se llena o se desconecta un micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espace libre et niveau de la route audio. Explique les coupures lorsque l’espace se remplit ou qu’un microphone est débranché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spazio libero e livello sonoro dell'instradamento audio. Spiega le interruzioni quando lo spazio si esaurisce o un microfono viene scollegato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オーディオルートの空き容量と音量。容量が足りなくなったり、マイクが外れたりしたときの途切れの原因を説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여유 공간과 오디오 라우트의 음량. 저장 공간이 가득 차거나 마이크가 빠져서 끊길 때 원인을 설명해 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ledig plass og volum på lydruten. Forklarer avbrudd når lagringsplassen blir full eller en mikrofon kobles fra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vrije opslag en volume van de audioroute. Verklaart haperingen als de opslag volloopt of een microfoon wordt losgekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wolne miejsce i głośność trasy audio. Wyjaśnia przerwy, gdy kończy się miejsce albo odłączono mikrofon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espaço livre e volume da rota de áudio. Explica interrupções quando o espaço acaba ou um microfone é desconectado."
          }
