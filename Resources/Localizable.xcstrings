          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar a compra e ela não foi liberada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível verificar a compra e nada foi desbloqueado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
