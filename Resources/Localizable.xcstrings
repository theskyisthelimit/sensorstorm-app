    "Der App Store ist gerade nicht erreichbar. Versuche es später noch einmal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store غير متاح حاليًا. حاول لاحقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store je právě nedostupný. Zkuste to později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store kan ikke nås lige nu. Prøv igen senere."
