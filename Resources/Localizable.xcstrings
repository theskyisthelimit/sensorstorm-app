        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un punto cada pocos metros, también con la pantalla bloqueada. Para ello iOS muestra la barra azul."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un point tous les quelques mètres, même écran verrouillé. iOS affiche pour cela la barre bleue."
