          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veien ble gått mellom %@ og %@ og er tegnet inn på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
