    "Zu wenige Fixes für eine Mittelung. Versuche es unter freiem Himmel nochmals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقاط أقل من أن يُؤخذ متوسط. حاول مجددًا تحت السماء المفتوحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš málo fixů pro průměrování. Zkuste to znovu pod otevřeným nebem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For få fix til en midling. Prøv igen under åben himmel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ λίγα στίγματα για μέσο όρο. Δοκίμασε ξανά κάτω από ανοιχτό ουρανό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too few fixes to average. Try again under open sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy pocos fix para promediar. Inténtalo de nuevo a cielo abierto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian vähän fixejä keskiarvoistukseen. Yritä uudelleen avoimen taivaan alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop peu de points pour une moyenne. Réessayez à ciel ouvert."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premalo fixeva za prosjek. Pokušaj ponovno pod otvorenim nebom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl kevés fix az átlagoláshoz. Próbáld újra nyílt ég alatt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo pochi fix per una media. Riprova sotto cielo libero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均を取るにはフィックスが足りません。空の見える場所でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평균을 내기에는 픽스가 너무 적어요. 하늘이 트인 곳에서 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For få fikser til en midling. Prøv igjen under åpen himmel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te weinig fixes voor een middeling. Probeer het opnieuw onder open hemel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za mało fixów do uśrednienia. Spróbuj ponownie pod otwartym niebem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poucos fix para uma média. Tente de novo sob céu aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes insuficientes para uma média. Tenta de novo sob céu aberto."
          }
