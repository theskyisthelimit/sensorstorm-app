          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas enregistrer de vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può registrare video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede grabar vídeo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan geen video opnemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não consegue gravar vídeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では動画を記録できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
