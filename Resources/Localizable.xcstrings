    "Sucht die Geräte im lokalen Netz und nennt, wie viele es sind." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبحث عن الأجهزة في الشبكة المحلية ويذكر عددها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Najde zařízení v místní síti a řekne, kolik jich je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Finder enhederne på det lokale netværk og siger, hvor mange der er."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εντοπίζει τις συσκευές στο τοπικό δίκτυο και λέει πόσες είναι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Finds the devices on the local network and says how many there are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Busca los dispositivos de la red local e indica cuántos hay."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hakee laitteet lähiverkosta ja kertoo, kuinka monta niitä on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cherche les appareils du réseau local et indique combien il y en a."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traži uređaje u lokalnoj mreži i javlja koliko ih ima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Megkeresi a helyi hálózat eszközeit, és megmondja, hány van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trova i dispositivi nella rete locale e dice quanti sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ローカルネットワーク上の端末を探し、台数を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로컬 네트워크의 기기를 찾아 몇 대인지 알려줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Finner enhetene på det lokale nettverket og sier hvor mange det er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zoekt de apparaten in het lokale netwerk en meldt hoeveel het er zijn."
          }
        },
