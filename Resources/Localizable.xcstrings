        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγγραφή ως .ssbin, χωρίς απώλειες και σε πλήρη ανάλυση, αντί για στρογγυλοποιημένη σε CSV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording as .ssbin, lossless and at full resolution, rather than rounded into CSV."
