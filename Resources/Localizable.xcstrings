    "Karte unter das Fadenkreuz schieben. Der GPS-Fix und sein Genauigkeitskreis bleiben sichtbar und werden mitgespeichert." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the map under the crosshair. The GPS fix and its accuracy circle stay visible and are stored alongside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el mapa bajo la retícula. El fix del GPS y su círculo de precisión siguen visibles y se guardan también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la carte sous le réticule. Le point GPS et son cercle de précision restent visibles et sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la mappa sotto il mirino. Il fix GPS e il suo cerchio di precisione restano visibili e vengono salvati insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十字線の下で地図を動かしてください。GPS フィックスと精度円は表示されたまま残り、一緒に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "십자선 아래에서 지도를 움직이세요. GPS 픽스와 정확도 원은 계속 보이며 함께 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuif de kaart onder het draadkruis. De GPS-fix en zijn nauwkeurigheidscirkel blijven zichtbaar en worden mee opgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o mapa sob a mira. O fix do GPS e seu círculo de precisão continuam visíveis e são salvos junto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desloca o mapa por baixo da mira. O fix GPS e o seu círculo de precisão continuam visíveis e são guardados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сдвиньте карту под перекрестье. Фикс GPS и его круг точности остаются видимыми и сохраняются вместе с ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "把地图移到十字准星下方。GPS 定位及其精度圈仍然可见，并会一并保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在十字準星下方移動地圖。GPS 定位點與其精度圓會持續顯示，並一併保存。"
          }
        }
      }
    },
