    "Misst Signal und Entfernung zu iBeacons mit den eingetragenen Kennungen. Nur im Vordergrund." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Měří signál a vzdálenost k iBeaconům se zadanými identifikátory. Jen na popředí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Måler signal og afstand til iBeacons med de indtastede id'er. Kun i forgrunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Measures signal and distance to iBeacons with the identifiers you entered. Foreground only."
          }
        },
        "es" : {
          "stringUnit" : {
