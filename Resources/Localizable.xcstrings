    "Liest Temperatur, Feuchte, CO₂, Licht, Kontakt und Bewegung aus dem eigenen Zuhause, solange die Aufnahme läuft." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
