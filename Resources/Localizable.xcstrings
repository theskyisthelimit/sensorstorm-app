    "Nadel von Hand gesetzt, %@ m vom GPS-Fix. Beide Positionen werden gespeichert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin placed by hand, %@ m from the GPS fix. Both positions are stored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épingle posée à la main, à %@ m du point GPS. Les deux positions sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spillo posato a mano, a %@ m dal fix GPS. Entrambe le posizioni vengono salvate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chincheta puesta a mano, a %@ m del fix GPS. Se guardan ambas posiciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfinete colocado à mão, a %@ m do fix de GPS. As duas posições são salvas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfinete colocado à mão, a %@ m do fix de GPS. As duas posições são guardadas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speld met de hand gezet, %@ m van de GPS-fix. Beide posities worden bewaard."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nål sat i hånden, %@ m fra GPS-fixet. Begge positioner gemmes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nål satt för hand, %@ m från GPS-fixen. Båda positionerna sparas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nål satt for hånd, %@ m fra GPS-fiksen. Begge posisjonene lagres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuppineula asetettu käsin, %@ m GPS-korjauksesta. Molemmat sijainnit tallennetaan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πινέζα τοποθετημένη με το χέρι, %@ m από τη μέτρηση GPS. Αποθηκεύονται και οι δύο θέσεις."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kézzel elhelyezett gombostű, %@ m-re a GPS-méréstől. Mindkét pozíció mentésre kerül."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinezka postawiona ręcznie, %@ m od odczytu GPS. Obie pozycje są zapisywane."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Špendlík umístěný ručně, %@ m od údaje GPS. Obě polohy se ukládají."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Špendlík umiestnený ručne, %@ m od údaja GPS. Obe polohy sa ukladajú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pribadača postavljena rukom, %@ m od GPS očitaja. Obje se pozicije spremaju."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ac pus cu mâna, la %@ m de citirea GPS. Ambele poziții sunt salvate."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İğne elle konuldu, GPS okumasından %@ m uzakta. İki konum da saklanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Булавка поставлена вручную, в %@ м от измерения GPS. Сохраняются обе позиции."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шпильку поставлено вручну, за %@ м від вимірювання GPS. Обидві позиції зберігаються."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دبوس وُضع يدويًا، على بعد %@ م من قراءة GPS. يُحفَظ الموقعان كلاهما."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動で置いたピン。GPS測位から %@ m。両方の位置が保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손으로 놓은 핀. GPS 측위에서 %@ m 떨어져 있어요. 두 위치 모두 저장돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动放置的图钉，距 GPS 定位 %@ m。两个位置都会保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動放置的圖釘，距 GPS 定位 %@ m。兩個位置都會儲存。"
          }
        }
      }
    },
