        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tilgang til posisjonen. Uten den gjenstår bare nålen for hånd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen toegang tot de locatie. Zonder locatie blijft alleen de met de hand geplaatste speld over."
