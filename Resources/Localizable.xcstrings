        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nätverket som telefonen är ansluten till: gränssnitt, enheter, ping, traceroute, DNS, portar, certifikat och genomströmning. Det som iOS inte lämnar ut (hårdvaruadresser, Wi-Fi-kanaler, grannätverk) saknas här och hittas inte på."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "手机所在的网络：接口、设备、Ping、Traceroute、DNS、端口、证书和吞吐量。iOS 不提供的内容（硬件地址、Wi-Fi 信道、邻近网络）这里没有，也不会假装有。"
          }
