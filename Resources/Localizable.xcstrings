    "Freier Speicher und Lautstärke der Audio-Route. Erklärt Aussetzer, wenn der Speicher voll läuft oder ein Mikrofon abgezogen wird." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المساحة الحرة ومستوى صوت مسار الصوت. تفسّر الانقطاعات عند امتلاء التخزين أو فصل ميكروفون."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volné místo a hlasitost zvukové trasy. Vysvětluje výpadky, když dojde místo nebo se odpojí mikrofon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ledig plads og lydstyrke på lydroutingen. Forklarer udfald, når pladsen løber fuld, eller en mikrofon trækkes ud."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ελεύθερος χώρος και ένταση της δρομολόγησης ήχου. Εξηγεί τις διακοπές όταν γεμίζει ο χώρος ή αποσυνδέεται ένα μικρόφωνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Free storage and volume of the audio route. Explains dropouts when storage fills up or a microphone is unplugged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espacio libre y volumen de la ruta de audio. Explica los cortes cuando el almacenamiento se llena o se desconecta un micrófono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vapaa tallennustila ja äänireitityksen äänenvoimakkuus. Selittää katkokset, kun tila täyttyy tai mikrofoni irrotetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espace libre et niveau de la route audio. Explique les coupures lorsque l’espace se remplit ou qu’un microphone est débranché."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slobodan prostor i glasnoća audio usmjeravanja. Objašnjava ispade kad se prostor napuni ili se mikrofon izvuče."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A szabad tárhely és a hangkimenet hangereje. Megmagyarázza a kimaradásokat, ha betelik a tárhely, vagy kihúznak egy mikrofont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spazio libero e livello sonoro dell'instradamento audio. Spiega le interruzioni quando lo spazio si esaurisce o un microfono viene scollegato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オーディオルートの空き容量と音量。容量が足りなくなったり、マイクが外れたりしたときの途切れの原因を説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여유 공간과 오디오 라우트의 음량. 저장 공간이 가득 차거나 마이크가 빠져서 끊길 때 원인을 설명해 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ledig plass og volum på lydruten. Forklarer avbrudd når lagringsplassen blir full eller en mikrofon kobles fra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vrije opslag en volume van de audioroute. Verklaart haperingen als de opslag volloopt of een microfoon wordt losgekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wolne miejsce i głośność trasy audio. Wyjaśnia przerwy, gdy kończy się miejsce albo odłączono mikrofon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espaço livre e volume da rota de áudio. Explica interrupções quando o espaço acaba ou um microfone é desconectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espaço livre e volume da rota de áudio. Explica falhas quando o espaço se esgota ou um microfone é desligado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spațiul liber și volumul rutării audio. Explică întreruperile când spațiul se umple sau un microfon este deconectat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Свободная память и громкость аудиотракта. Объясняет сбои, когда память заполняется или отключается микрофон."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voľné miesto a hlasitosť pri smerovaní zvuku. Vysvetľuje výpadky, keď sa úložisko zaplní alebo sa odpojí mikrofón."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ledigt utrymme och volym för ljudrouting. Förklarar avbrott när utrymmet tar slut eller en mikrofon dras ur."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Boş depolama alanı ve ses rotasının ses düzeyi. Depolama dolduğunda ya da bir mikrofon çıkarıldığında oluşan kesintileri açıklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вільне місце й гучність аудіомаршруту. Пояснює збої, коли пам’ять заповнюється або мікрофон відключено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
