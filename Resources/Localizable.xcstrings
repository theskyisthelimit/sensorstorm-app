    "Zu wenig Fahrt zum Beurteilen: es braucht Beschleunigung mit mindestens 20 Hz und eine Geschwindigkeit zwischen 11 und 160 km/h." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الرحلة قصيرة جدًا للتقييم: يلزم تسارع بمعدل 20 Hz على الأقل وسرعة بين 11 و160 km/h."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Příliš málo jízdy pro posouzení: je potřeba zrychlení s frekvencí alespoň 20 Hz a rychlost mezi 11 a 160 km/h."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "For lidt kørsel til vurdering: Det kræver acceleration på mindst 20 Hz og en hastighed mellem 11 og 160 km/h."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πολύ λίγη οδήγηση για αξιολόγηση: χρειάζεται επιτάχυνση τουλάχιστον 20 Hz και ταχύτητα μεταξύ 11 και 160 km/h."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Not enough driving to assess: it needs acceleration of at least 20 Hz and a speed between 11 and 160 km/h."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poca conducción para evaluar: se necesita aceleración de al menos 20 Hz y una velocidad entre 11 y 160 km/h."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
