          "stringUnit": {
            "state": "translated",
            "value": "GPS reported %@, %@ — both are stored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS indiquait %@, %@ — les deux sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il GPS indicava %@, %@ — entrambi sono conservati."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El GPS indicaba %@, %@: se conservan ambos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De GPS meldde %@, %@ — beide zijn bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GPS indicava %@, %@ — os dois ficam guardados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS は %@, %@ を示していました — どちらも保存されています。"
