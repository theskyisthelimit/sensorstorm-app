    "Schalte oben die Kamera ein. Ohne Bild gibt es keine Kamerapose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الكاميرا في الأعلى. بلا صورة لا توجد وضعية كاميرا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte nahoře fotoaparát. Bez obrazu není póza kamery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tænd kameraet foroven. Uden billede er der ingen kamerapose."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άναψε την κάμερα επάνω. Χωρίς εικόνα δεν υπάρχει πόζα κάμερας."
