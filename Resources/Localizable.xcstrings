    "Du kannst markieren, wie weit der Schaden reicht: als Kreis um dich herum oder als Polygon entlang des Rands." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تحديد مدى امتداد الضرر: كدائرة حولك أو كمضلّع على طول الحافة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete označit, kam až škoda sahá: jako kruh kolem sebe nebo jako mnohoúhelník podél okraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan markere, hvor langt skaden rækker: som cirkel omkring dig eller som polygon langs kanten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείς να σημάνεις πόσο μακριά φτάνει η ζημιά: ως κύκλος γύρω σου ή ως πολύγωνο κατά μήκος του άκρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can mark how far the damage reaches: as a circle around you or as a polygon along its edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes marcar hasta dónde llega el daño: como círculo a tu alrededor o como polígono a lo largo del borde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit merkitä, kuinka pitkälle vaurio ulottuu: ympyränä ympärilläsi tai monikulmiona reunaa pitkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez marquer jusqu’où va le dégât : en cercle autour de vous ou en polygone le long du bord."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možeš označiti dokle seže oštećenje: kao krug oko sebe ili kao mnogokut uz rub."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjelölheted, meddig ér a kár: körként magad körül vagy sokszögként a perem mentén."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi segnare fin dove arriva il danno: come cerchio intorno a te o come poligono lungo il bordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "損傷がどこまで及ぶかをマークできます：自分を中心とした円、または縁に沿ったポリゴンとして。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손상이 어디까지인지 표시할 수 있어요: 자기 주위의 원으로, 또는 가장자리를 따라가는 다각형으로."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan markere hvor langt skaden rekker: som sirkel rundt deg eller som polygon langs kanten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt markeren hoe ver de schade reikt: als cirkel om je heen of als polygoon langs de rand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zaznaczyć, jak daleko sięga uszkodzenie: jako okrąg wokół siebie albo jako wielokąt wzdłuż krawędzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode marcar até onde vai o dano: como círculo em volta de você ou como polígono ao longo da borda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes marcar até onde chega o dano: como círculo à tua volta ou como polígono ao longo da borda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți marca până unde ajunge dauna: ca cerc în jurul tău sau ca poligon de-a lungul marginii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно отметить, насколько далеко идёт повреждение: кругом вокруг вас или многоугольником по краю."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môžete označiť, kam až škoda siaha: ako kruh okolo seba alebo ako mnohouholník pozdĺž okraja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan markera hur långt skadan sträcker sig: som cirkel runt dig eller som polygon längs kanten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasarın nereye kadar uzandığını işaretleyebilirsin: çevrende bir çember olarak ya da kenar boyunca bir çokgen olarak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна позначити, як далеко сягає пошкодження: колом навколо себе або багатокутником по краю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以标记损坏延伸到哪里：以你为中心的圆，或沿着边缘的多边形。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以標記損壞延伸到哪裡：以你為中心的圓，或沿著邊緣的多邊形。"
          }
        }
      }
    },
