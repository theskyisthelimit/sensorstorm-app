        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這條路線仍可完整使用：繼續記錄觀測點、編輯，並匯出為 CSV。若要依街道、依委託或依日期並排多條路線，就需要 Pro。"
          }
        }
      }
