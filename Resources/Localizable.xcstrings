    "Routen und Aufnahmen als ein Zip mit %@: eine Datei, die das ganze Archiv maschinenlesbar beschreibt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes and recordings as one zip with %@: a single file that describes the whole archive in machine-readable form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorridos y grabaciones en un ZIP con %@: un archivo que describe todo el conjunto de forma legible por una máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcours et enregistrements dans un ZIP avec %@ : un fichier qui décrit toute l'archive de façon lisible par une machine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorsi e registrazioni in un unico ZIP con %@: un file che descrive l'intero archivio in modo leggibile da una macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ルートと記録を %@ 付きの1つの ZIP に。アーカイブ全体を機械可読に記述する1ファイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "경로와 기록을 %@이(가) 담긴 ZIP 하나로. 아카이브 전체를 기계가 읽을 수 있게 설명하는 파일 하나입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Routes en opnamen als één ZIP met %@: één bestand dat het hele archief machineleesbaar beschrijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percursos e gravações em um ZIP com %@: um arquivo que descreve todo o conjunto de forma legível por máquina."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
