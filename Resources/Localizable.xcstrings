        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стабілізація зображення лишається вимкненою, щоб картинка точно збігалася з даними руху."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像防抖保持关闭，好让画面与运动数据精确对应。"
          }
