        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για δικό σου πίνακα, Node-RED ή Home Assistant. Χωρίς καταχωρημένη διεύθυνση η εφαρμογή δεν δημιουργεί σύνδεση."
          }
        },
        "en" : {
          "stringUnit" : {
