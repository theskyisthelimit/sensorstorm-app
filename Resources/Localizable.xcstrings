    "Erst lesen oder abonnieren, damit ein Wert da ist, an dem sich die Felder prüfen lassen." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nejdřív čtěte nebo odebírejte, aby existovala hodnota, na které lze pole zkontrolovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Læs eller abonnér først, så der findes en værdi, som felterne kan kontrolleres mod."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Read or subscribe first so there is a value against which the fields can be checked."
          }
