    "Herzfrequenz und Handgelenkbewegung kommen von einer Apple Watch. Dieses Gerät kann keine koppeln." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل ضربات القلب وحركة المعصم يأتيان من Apple Watch. هذا الجهاز لا يمكنه إقران واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tep a pohyb zápěstí pocházejí z Apple Watch. Toto zařízení je nedokáže spárovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls og håndledsbevægelse kommer fra et Apple Watch. Denne enhed kan ikke pardanne med et."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο καρδιακός παλμός και η κίνηση του καρπού έρχονται από ένα Apple Watch. Αυτή η συσκευή δεν μπορεί να συζευχθεί με κάποιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart rate and wrist motion come from an Apple Watch. This device cannot pair one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia cardiaca y el movimiento de la muñeca vienen de un Apple Watch. Este dispositivo no puede enlazar ninguno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syke ja ranteen liike tulevat Apple Watchista. Tämä laite ei voi muodostaa paria kellon kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fréquence cardiaque et le mouvement du poignet proviennent d’une Apple Watch. Cet appareil ne peut pas en jumeler."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls i pokret zapešća dolaze s Apple Watcha. Ovaj uređaj ga ne može upariti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pulzus és a csuklómozgás egy Apple Watch órától érkezik. Ez a készülék nem tud ilyet párosítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza cardiaca e movimento del polso arrivano da un Apple Watch. Questo dispositivo non può abbinarne uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数と手首の動きはApple Watchから届きます。この端末はペアリングできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수와 손목 움직임은 Apple Watch에서 와요. 이 기기는 페어링할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls og håndleddsbevegelse kommer fra en Apple Watch. Denne enheten kan ikke sammenkobles med en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartslag en polsbeweging komen van een Apple Watch. Dit apparaat kan er geen koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tętno i ruch nadgarstka pochodzą z Apple Watch. To urządzenie nie może go sparować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frequência cardíaca e o movimento do pulso vêm de um Apple Watch. Este dispositivo não pode parear nenhum."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frequência cardíaca e o movimento do pulso vêm de um Apple Watch. Este dispositivo não pode emparelhar nenhum."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsul și mișcarea încheieturii vin de la un Apple Watch. Acest dispozitiv nu poate asocia unul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс и движение запястья поступают с Apple Watch. Это устройство не может их подключить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tep a pohyb zápästia prichádzajú z Apple Watch. Toto zariadenie ich nedokáže spárovať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls och handledsrörelse kommer från en Apple Watch. Den här enheten kan inte parkoppla någon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabız ve bilek hareketi bir Apple Watch’tan gelir. Bu aygıt bir tane eşleştiremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс і рух зап’ястя надходять з Apple Watch. Цей пристрій не може створити з ним пару."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率和手腕动作来自 Apple Watch。此设备无法配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率和手腕動作來自 Apple Watch。這部裝置無法配對。"
          }
        }
      }
    },
    "Herzfrequenz und Handgelenkbewegung misst die Apple Watch, nicht das iPhone. Koppel eine Uhr in der Apple-Watch-App, dann erscheinen die beiden Ströme hier." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل ضربات القلب وحركة المعصم تقيسهما Apple Watch وليس iPhone. اقرن ساعة في تطبيق Apple Watch، وسيظهر التدفقان هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tep a pohyb zápěstí měří Apple Watch, ne iPhone. Spárujte hodinky v aplikaci Apple Watch a oba toky se objeví zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls og håndledsbevægelse måles af dit Apple Watch, ikke af din iPhone. Pardan et ur i Apple Watch-appen, så vises begge strømme her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τον καρδιακό παλμό και την κίνηση του καρπού τα μετρά το Apple Watch, όχι το iPhone. Σύζευξε ένα ρολόι στην εφαρμογή Apple Watch και οι δύο ροές θα εμφανιστούν εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart rate and wrist motion are measured by the Apple Watch, not the iPhone. Pair a watch in the Apple Watch app and both streams appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia cardiaca y el movimiento de la muñeca los mide el Apple Watch, no el iPhone. Enlaza un reloj en la app Apple Watch y los dos flujos aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sykkeen ja ranteen liikkeen mittaa Apple Watch, ei iPhone. Muodosta pari kellon kanssa Apple Watch -apissa, niin molemmat virrat näkyvät tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fréquence cardiaque et le mouvement du poignet sont mesurés par l’Apple Watch, pas par l’iPhone. Jumelez une montre dans l’app Apple Watch et les deux flux apparaîtront ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls i pokret zapešća mjeri Apple Watch, a ne iPhone. Upari sat u aplikaciji Apple Watch i oba toka pojavit će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pulzust és a csuklómozgást az Apple Watch méri, nem az iPhone. Párosíts egy órát az Apple Watch appban, és mindkét adatfolyam megjelenik itt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza cardiaca e movimento del polso li misura Apple Watch, non iPhone. Abbina un orologio nell’app Apple Watch e i due flussi compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数と手首の動きを測るのはApple Watchで、iPhoneではありません。Apple Watch Appで時計をペアリングすると、2つのストリームがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수와 손목 움직임은 iPhone이 아니라 Apple Watch가 측정해요. Apple Watch 앱에서 시계를 페어링하면 두 스트림이 여기에 나타나요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls og håndleddsbevegelse måles av Apple Watch, ikke av iPhone. Sammenkoble en klokke i Apple Watch-appen, så vises begge strømmene her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartslag en polsbeweging meet de Apple Watch, niet de iPhone. Koppel een horloge in de Apple Watch-app, dan verschijnen beide stromen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tętno i ruch nadgarstka mierzy Apple Watch, a nie iPhone. Sparuj zegarek w aplikacji Apple Watch, a oba strumienie pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frequência cardíaca e o movimento do pulso são medidos pelo Apple Watch, não pelo iPhone. Pareie um relógio no app Apple Watch e os dois fluxos aparecem aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frequência cardíaca e o movimento do pulso são medidos pelo Apple Watch, não pelo iPhone. Emparelha um relógio na app Apple Watch e os dois fluxos aparecem aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsul și mișcarea încheieturii le măsoară Apple Watch, nu iPhone. Asociază un ceas în aplicația Apple Watch și ambele fluxuri vor apărea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс и движение запястья измеряют Apple Watch, а не iPhone. Подключите часы в приложении Apple Watch, и оба потока появятся здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tep a pohyb zápästia meria Apple Watch, nie iPhone. Spárujte hodinky v aplikácii Apple Watch a oba toky sa zobrazia tu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls och handledsrörelse mäts av Apple Watch, inte av iPhone. Parkoppla en klocka i Apple Watch-appen, så visas båda strömmarna här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabzı ve bilek hareketini iPhone değil, Apple Watch ölçer. Apple Watch uygulamasında bir saat eşleştir; iki akış da burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс і рух зап’ястя вимірює Apple Watch, а не iPhone. Створіть пару з годинником у програмі Apple Watch, і обидва потоки з’являться тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率和手腕动作由 Apple Watch 测量，而非 iPhone。在 Apple Watch App 中配对手表后，这两条数据流会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率和手腕動作由 Apple Watch 測量，而非 iPhone。在 Apple Watch App 中配對手錶後，這兩條資料流會出現在這裡。"
          }
        }
      }
    },
    "Herzfrequenzgurte, Leistungsmesser, Trittfrequenz- und Laufsensoren senden ihre Werte erst nach einer Verbindung. Ein gekoppeltes Gerät wird bei jedem Start wieder verbunden." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hrudní pásy, výkonoměry, snímače kadence a běhu posílají hodnoty až po připojení. Spárované zařízení se při každém spuštění připojí znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsbælter, effektmålere, kadence- og løbesensorer sender først deres værdier efter en forbindelse. En parret enhed forbindes igen ved hver start."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heart rate straps, power meters, cadence and running sensors send their values only after a connection. A paired device is reconnected at every start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las bandas de frecuencia cardíaca, los medidores de potencia y los sensores de cadencia de pedaleo y de carrera envían sus valores solo después de conectarse. Un dispositivo enlazado se vuelve a conectar en cada inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les ceintures cardiaques, capteurs de puissance, de cadence et de course n’envoient leurs valeurs qu’après connexion. Un appareil jumelé est reconnecté à chaque démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fasce cardio, misuratori di potenza, sensori di cadenza e di corsa inviano i loro valori solo dopo una connessione. Un dispositivo abbinato viene ricollegato a ogni avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心拍ベルト、パワーメーター、ケイデンスセンサー、ランニングセンサーは、接続後にはじめて値を送信します。ペアリング済みの端末は、起動のたびに再接続されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "심박 밴드, 파워 미터, 케이던스 및 러닝 센서는 연결한 뒤에야 값을 보내요. 페어링한 기기는 시작할 때마다 다시 연결돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsbelter, wattmålere, kadens- og løpesensorer sender verdiene først etter at de er koblet til. En sammenkoblet enhet kobles til igjen ved hver start."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hartslagbanden, vermogensmeters, trapfrequentie- en loopsensoren sturen hun waarden pas na een verbinding. Een gekoppeld apparaat wordt bij elke start opnieuw verbonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasy do pomiaru tętna, mierniki mocy, czujniki kadencji i biegu wysyłają wartości dopiero po połączeniu. Sparowane urządzenie jest łączone ponownie przy każdym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cintas de frequência cardíaca, medidores de potência, sensores de cadência e de corrida só enviam seus valores após uma conexão. Um dispositivo pareado é reconectado a cada início."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cintas de frequência cardíaca, medidores de potência, sensores de cadência e de corrida só enviam os valores depois de ligados. Um aparelho emparelhado volta a ligar-se em cada arranque."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Curelele pentru puls, dispozitivele de măsurare a puterii, senzorii de cadență și de alergare își trimit valorile abia după conectare. Un dispozitiv asociat este reconectat la fiecare pornire."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hrudné pásy na meranie tepu, výkonomery a senzory kadencie a behu posielajú hodnoty až po pripojení. Spárované zariadenie sa pri každom spustení pripojí znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsband, effektmätare, kadens- och löpsensorer skickar sina värden först efter en anslutning. En parkopplad enhet ansluts igen vid varje start."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心率带、功率计、踏频和跑步传感器要在连接后才发送数值。已配对的设备每次启动都会重新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "心率帶、功率計、踏頻與跑步感測器要先連線才會傳送數值。已配對的裝置會在每次啟動時重新連線。"
          }
        }
      }
    },
