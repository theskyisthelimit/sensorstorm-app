    "GPS hatte %@, %@ gemeldet. Beides ist gespeichert." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغ GPS عن %@ و%@. كلاهما محفوظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS hlásila %@, %@. Obojí je uloženo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS meldte %@, %@. Begge er gemt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GPS ανέφερε %@, %@. Και τα δύο είναι αποθηκευμένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS reported %@, %@. Both are stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El GPS indicó %@, %@. Ambos están guardados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS ilmoitti %@, %@. Molemmat on tallennettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le GPS a indiqué %@, %@. Les deux sont enregistrés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS je javio %@, %@. Oboje je spremljeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GPS %@, %@ értéket jelzett. Mindkettő mentve van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il GPS ha indicato %@, %@. Entrambi sono salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS は %@、%@ を報告しました。どちらも保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS가 %@, %@를 알려 줬어요. 둘 다 저장돼 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS meldte %@, %@. Begge er lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS meldde %@, %@. Beide zijn bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS zgłosił %@, %@. Oba są zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GPS indicou %@, %@. Os dois estão salvos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GPS indicou %@, %@. Ambos estão guardados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS a raportat %@, %@. Ambele sunt salvate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS сообщил %@, %@. Сохранены оба."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS hlásila %@, %@. Oboje je uložené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS rapporterade %@, %@. Båda är sparade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS %@, %@ bildirdi. İkisi de kayıtlı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS повідомив %@, %@. Збережено обидва."
          }
        },
        "zh-Hans" : {
