    "Alles auf dem Gerät als ein Zip mit manifest.json: jede Datei mit SHA-256, jeder Fall mit Position und Bewertung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything on the device as one zip with manifest.json: every file with its SHA-256, every case with its position and severity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est sur l'appareil dans un ZIP avec manifest.json : chaque fichier avec son SHA-256, chaque cas avec sa position et sa gravité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è sul dispositivo in un unico ZIP con manifest.json: ogni file con il suo SHA-256, ogni caso con posizione e gravità."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
