    "Karte unter das Fadenkreuz schieben. Der GPS-Fix und sein Genauigkeitskreis bleiben sichtbar und werden mitgespeichert." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّك الخريطة تحت التقاطع. تبقى نقطة GPS ودائرة دقتها ظاهرتين وتُحفظان معها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posuňte mapu pod nitkový kříž. Fix GPS a jeho kruh přesnosti zůstávají viditelné a ukládají se s ním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub kortet ind under trådkorset. GPS-fixet og dets nøjagtighedscirkel bliver synlige og gemmes med."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρε τον χάρτη κάτω από το σταυρόνημα. Το στίγμα GPS και ο κύκλος ακρίβειάς του παραμένουν ορατά και αποθηκεύονται μαζί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the map under the crosshair. The GPS fix and its accuracy circle stay visible and are stored alongside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el mapa bajo la retícula. El fix del GPS y su círculo de precisión siguen visibles y se guardan también."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä karttaa hiusristikon alle. GPS-fix ja sen tarkkuusympyrä pysyvät näkyvissä ja tallentuvat mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la carte sous le réticule. Le point GPS et son cercle de précision restent visibles et sont conservés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomakni kartu pod nišan. GPS fix i njegov krug točnosti ostaju vidljivi i spremaju se s njim."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Told a térképet a szálkereszt alá. A GPS-fix és pontossági köre látható marad, és mentésre kerül vele."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la mappa sotto il mirino. Il fix GPS e il suo cerchio di precisione restano visibili e vengono salvati insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十字線の下で地図を動かしてください。GPS フィックスと精度円は表示されたまま残り、一緒に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "십자선 아래에서 지도를 움직이세요. GPS 픽스와 정확도 원은 계속 보이며 함께 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyv kartet under trådkorset. GPS-fiksen og nøyaktighetssirkelen forblir synlige og lagres med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuif de kaart onder het draadkruis. De GPS-fix en zijn nauwkeurigheidscirkel blijven zichtbaar en worden mee opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń mapę pod celownik. Fix GPS i jego okrąg dokładności pozostają widoczne i są zapisywane razem z nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o mapa sob a mira. O fix do GPS e seu círculo de precisão continuam visíveis e são salvos junto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca o mapa por baixo da mira. O fix GPS e o seu círculo de precisão continuam visíveis e são guardados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mută harta sub reticul. Fixul GPS și cercul lui de precizie rămân vizibile și se salvează odată cu el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвиньте карту под перекрестье. Фикс GPS и его круг точности остаются видимыми и сохраняются вместе с ним."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posuňte mapu pod nitkový kríž. Fix GPS a jeho kruh presnosti zostávajú viditeľné a ukladajú sa s ním."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjut kartan under hårkorset. GPS-fixet och dess noggrannhetscirkel förblir synliga och sparas med."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritayı artı işaretinin altına kaydır. GPS sabitlemesi ve doğruluk çemberi görünür kalır ve birlikte kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посуньте карту під перехрестя. Фікс GPS та його коло точності лишаються видимими й зберігаються разом із ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把地图移到十字准星下方。GPS 定位及其精度圈仍然可见，并会一并保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在十字準星下方移動地圖。GPS 定位點與其精度圓會持續顯示，並一併保存。"
          }
        }
      }
    },
