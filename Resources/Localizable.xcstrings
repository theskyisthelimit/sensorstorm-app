    "Begehungen und Aufnahmen als ein Zip mit %@: eine Datei, die das ganze Archiv maschinenlesbar beschreibt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveys and recordings as one zip with %@: a single file that describes the whole archive in machine-readable form."
          }
        }
      }
    },
    "Belagsausbruch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface break-up"
          }
        }
      }
    },
    "Beliebig viele Begehungen nebeneinander — pro Strasse, pro Auftrag, pro Tag.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any number of surveys side by side — per street, per job, per day."
          }
        }
      }
    },
