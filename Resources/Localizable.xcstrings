    "Routen und Aufnahmen als ein Zip mit %@: eine Datei, die das ganze Archiv maschinenlesbar beschreibt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسارات والتسجيلات في ملف zip واحد مع %@: ملف واحد يصف الأرشيف كله بصيغة تقرأها الآلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy a záznamy jako jeden zip s %@: jeden soubor, který popisuje celý archiv strojově čitelně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruter og optagelser som ét zip med %@: én fil, der beskriver hele arkivet maskinlæsbart."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαδρομές και εγγραφές ως ένα zip με %@: ένα αρχείο που περιγράφει ολόκληρη την αρχειοθήκη με τρόπο αναγνώσιμο από μηχανή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes and recordings as one zip with %@: a single file that describes the whole archive in machine-readable form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorridos y grabaciones en un ZIP con %@: un archivo que describe todo el conjunto de forma legible por una máquina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reitit ja tallenteet yhtenä zip-tiedostona, mukana %@: yksi tiedosto, joka kuvaa koko arkiston koneluettavasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcours et enregistrements dans un ZIP avec %@ : un fichier qui décrit toute l'archive de façon lisible par une machine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rute i snimke kao jedan zip s %@: jedna datoteka koja strojno čitljivo opisuje cijelu arhivu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útvonalak és felvételek egyetlen zipben, %@ fájllal: egy fájl, amely gépi olvasásra írja le az egész archívumot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorsi e registrazioni in un unico ZIP con %@: un file che descrive l'intero archivio in modo leggibile da una macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートと記録を %@ 付きの1つの ZIP に。アーカイブ全体を機械可読に記述する1ファイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로와 기록을 %@이(가) 담긴 ZIP 하나로. 아카이브 전체를 기계가 읽을 수 있게 설명하는 파일 하나입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruter og opptak som én zip med %@: én fil som beskriver hele arkivet maskinlesbart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes en opnamen als één ZIP met %@: één bestand dat het hele archief machineleesbaar beschrijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy i nagrania jako jeden zip z %@: jeden plik, który opisuje całe archiwum w sposób czytelny dla maszyny."
          }
        },
        "pt-BR" : {
