        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Απομακρυσμένη πρόσβαση στη γραμμή εντολών χωρίς κρυπτογράφηση. Απενεργοποίησέ την ή αντικατάστησέ την με SSH."
          }
        },
        "en" : {
