    "Begehungen und Aufnahmen als ein Zip mit %@: eine Datei, die das ganze Archiv maschinenlesbar beschreibt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveys and recordings as one zip with %@: a single file that describes the whole archive in machine-readable form."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours et enregistrements dans un ZIP avec %@ : un fichier qui décrit toute l'archive de façon lisible par une machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorsi e registrazioni in un unico ZIP con %@: un file che descrive l'intero archivio in modo leggibile da una macchina."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorridos y grabaciones en un ZIP con %@: un archivo que describe todo el conjunto de forma legible por una máquina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondes en opnamen als één ZIP met %@: één bestand dat het hele archief machineleesbaar beschrijft."
          }
        }
      }
    },
