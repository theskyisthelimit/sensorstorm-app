    "Gilt für alle Bewegungssensoren. GPS, Barometer und Schrittzähler liefern in ihrem eigenen Takt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسري على كل مستشعرات الحركة. أما GPS والبارومتر وعدّاد الخطوات فتعطي بإيقاعها الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro všechny pohybové senzory. GPS, barometr a krokoměr dodávají data ve vlastním rytmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder for alle bevægelsessensorer. GPS, barometer og skridttæller leverer i deres eget tempo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για όλους τους αισθητήρες κίνησης. Το GPS, το βαρόμετρο και το βηματόμετρο δίνουν δεδομένα με τον δικό τους ρυθμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to every motion sensor. GPS, barometer and pedometer report at their own cadence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todos los sensores de movimiento. El GPS, el barómetro y el podómetro entregan datos a su propio ritmo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee kaikkia liikeantureita. GPS, ilmanpainemittari ja askelmittari tuottavat dataa omaan tahtiinsa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique à tous les capteurs de mouvement. GPS, baromètre et podomètre livrent à leur propre rythme."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi za sve senzore kretanja. GPS, barometar i brojač koraka daju podatke svojim ritmom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden mozgásérzékelőre érvényes. A GPS, a barométer és a lépésszámláló a saját ütemében szolgáltat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per tutti i sensori di movimento. GPS, barometro e contapassi forniscono dati con il proprio ritmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのモーションセンサーに適用されます。GPS、気圧計、歩数計はそれぞれ独自の間隔で値を返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 모션 센서에 적용됩니다. GPS, 기압계, 만보계는 각자의 주기로 값을 냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder alle bevegelsessensorer. GPS, barometer og skritteller leverer i sin egen takt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor alle bewegingssensoren. GPS, barometer en stappenteller leveren in hun eigen tempo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy wszystkich czujników ruchu. GPS, barometr i krokomierz dostarczają dane we własnym rytmie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para todos os sensores de movimento. GPS, barômetro e pedômetro entregam no ritmo deles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para todos os sensores de movimento. GPS, barómetro e pedómetro entregam no seu próprio ritmo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valabil pentru toți senzorii de mișcare. GPS, barometrul și pedometrul livrează în ritmul lor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для всех датчиков движения. GPS, барометр и шагомер выдают данные в своём ритме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pre všetky pohybové senzory. GPS, barometer a krokomer dodávajú dáta vo vlastnom rytme."
          }
        },
        "sv" : {
