    "Zur Aufnahme %@ erfasst — die Fälle liegen auf derselben Uhr wie deren Sensordaten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured during recording %@ — the cases sit on the same clock as its sensor data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisi pendant l'enregistrement %@ — les cas sont sur la même horloge que ses données de capteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato durante la registrazione %@ — i casi sono sullo stesso orologio dei suoi dati dei sensori."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado durante la grabación %@: los casos están en el mismo reloj que sus datos de sensores."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgelegd tijdens opname %@ — de gevallen liggen op dezelfde klok als haar sensordata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado durante a gravação %@ — os casos estão no mesmo relógio dos dados de sensores dela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録 %@ の最中に取得 — 事案はその記録のセンサーデータと同じ時計の上にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 %@ 중에 수집됨 — 사례는 해당 기록의 센서 데이터와 같은 시계 위에 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於記錄 %@ 期間採集 — 案件與該記錄的感測器資料位於同一個時鐘上。"
          }
        }
      }
    },
