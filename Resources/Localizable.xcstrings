    "Die laufende Aufnahme benutzt die Kamera. Beobachtung ohne Foto erfassen oder die Aufnahme stoppen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيل الجاري يستخدم الكاميرا. سجّل الملاحظة بلا صورة أو أوقف التسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probíhající záznam používá fotoaparát. Zaznamenejte pozorování bez fotky nebo záznam zastavte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den igangværende optagelse bruger kameraet. Registrér observationen uden foto, eller stop optagelsen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγγραφή που τρέχει χρησιμοποιεί την κάμερα. Κατέγραψε την παρατήρηση χωρίς φωτογραφία ή σταμάτησε την εγγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The running recording is using the camera. Capture the observation without a photo, or stop the recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación en curso está usando la cámara. Registra la observación sin foto o detén la grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnissä oleva tallennus käyttää kameraa. Kirjaa havainto ilman kuvaa tai lopeta tallennus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement en cours utilise la caméra. Saisissez l'observation sans photo ou arrêtez l'enregistrement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snimanje u tijeku koristi kameru. Zabilježi opažanje bez fotografije ili zaustavi snimanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A futó felvétel használja a kamerát. Rögzítsd az észlelést fotó nélkül, vagy állítsd le a felvételt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione in corso sta usando la fotocamera. Registra l’osservazione senza foto oppure interrompi la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録中のためカメラを使用しています。写真なしで観測点を記録するか、記録を停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 기록이 카메라를 사용하고 있습니다. 사진 없이 관측을 기록하거나 기록을 중지하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptaket som pågår bruker kameraet. Registrer observasjonen uten foto, eller stopp opptaket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lopende opname gebruikt de camera. Leg de waarneming zonder foto vast of stop de opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwające nagranie zajmuje aparat. Zapisz obserwację bez zdjęcia albo zatrzymaj nagranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação em andamento está usando a câmera. Registre a observação sem foto ou pare a gravação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação em curso está a usar a câmara. Regista a observação sem foto ou para a gravação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrarea în curs folosește camera. Înregistrează observația fără fotografie sau oprește înregistrarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идущая запись занимает камеру. Запишите наблюдение без фото или остановите запись."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prebiehajúci záznam používa fotoaparát. Zaznamenajte pozorovanie bez fotky alebo záznam zastavte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den pågående inspelningen använder kameran. Registrera observationen utan foto eller stoppa inspelningen."
