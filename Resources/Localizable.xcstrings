    "Der Weg wurde zwischen %@ und %@ begangen und ist auf der Karte eingetragen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم قطع الطريق بين %@ و%@ وهو مرسوم على الخريطة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stopa byla projita mezi %@ a %@ a je zanesena do mapy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stien blev gået mellem %@ og %@ og er indtegnet på kortet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
