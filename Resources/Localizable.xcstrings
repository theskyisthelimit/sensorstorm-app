    "Der Kauf liess sich nicht überprüfen und wurde nicht freigeschaltet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من الشراء ولم يُفعَّل شيء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákup se nepodařilo ověřit a nic nebylo odemčeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet kunne ikke bekræftes og blev ikke låst op."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αγορά δεν μπόρεσε να επαληθευτεί και δεν ξεκλειδώθηκε τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase could not be verified and was not unlocked."
          }
        },
        "es" : {
          "stringUnit" : {
