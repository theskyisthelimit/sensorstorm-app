    "Die Route als GeoJSON für QGIS, als KML für Google Earth, als GPX zum Wiederfinden, oder als Bündel mit jedem Foto und Clip." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسار بصيغة GeoJSON لـ QGIS، وKML لـ Google Earth، وGPX للعثور عليه مجددًا، أو كحزمة مع كل صورة ومقطع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasa jako GeoJSON pro QGIS, jako KML pro Google Earth, jako GPX pro opětovné nalezení, nebo jako balík s každou fotkou a klipem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruten som GeoJSON til QGIS, som KML til Google Earth, som GPX til at finde den igen, eller som bundt med hvert foto og klip."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαδρομή ως GeoJSON για το QGIS, ως KML για το Google Earth, ως GPX για να την ξαναβρείς, ή ως πακέτο με κάθε φωτογραφία και κλιπ."
          }
        },
        "en" : {
          "stringUnit" : {
