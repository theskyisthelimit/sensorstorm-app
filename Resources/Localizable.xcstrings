    "Höhe über Meer aus GPS und Barometer zusammen, genauer als jede der beiden allein. Für Stockwerke und Gefälle." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nadmořská výška z GPS a barometru dohromady, přesnější než každý z nich sám. Pro patra a sklony."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Højde over havet ud fra GPS og barometer samlet, mere nøjagtig end hver af dem alene. Til etager og stigninger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altitude above sea level from GPS and barometer combined, more accurate than either alone. For floors and gradients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altitud sobre el nivel del mar a partir de GPS y barómetro combinados, más precisa que cada uno por separado. Para plantas y pendientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altitude au-dessus du niveau de la mer à partir du GPS et du baromètre combinés, plus précise que chacun seul. Pour les étages et les pentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quota sul livello del mare da GPS e barometro insieme, più precisa di ciascuno dei due da solo. Per piani e pendenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GPS と気圧計を組み合わせた海抜高度で、どちらか単独よりも高精度です。階数や勾配の把握に使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GPS와 기압계를 합친 해발 고도로, 둘 중 하나만 쓸 때보다 정확해요. 층수와 경사를 볼 때 쓰세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Høyde over havet fra GPS og barometer samlet, mer nøyaktig enn hver av dem alene. For etasjer og fall."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoogte boven zeeniveau uit GPS en barometer samen, nauwkeuriger dan elk van beide afzonderlijk. Voor verdiepingen en hellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wysokość nad poziomem morza z GPS i barometru razem, dokładniejsza niż każde z nich osobno. Do pięter i spadków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altitude acima do nível do mar a partir de GPS e barômetro combinados, mais precisa que cada um sozinho. Para andares e declives."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altitude acima do nível do mar a partir do GPS e do barómetro em conjunto, mais exata do que cada um isolado. Para pisos e declives."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altitudine deasupra nivelului mării din GPS și barometru combinate, mai precisă decât oricare dintre ele singură. Pentru etaje și pante."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nadmorská výška z GPS a barometra spolu, presnejšia než každé z nich samostatne. Pre poschodia a sklony."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Höjd över havet från GPS och barometer tillsammans, noggrannare än var och en för sig. För våningar och lutning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "海拔高度由 GPS 和气压计综合得出，比单独使用任一种都更准确。适用于楼层和坡度。"
          }
        },
        "zh-Hant" : {
