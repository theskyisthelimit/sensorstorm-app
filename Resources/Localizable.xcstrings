    "Regeln reagieren während einer Aufnahme auf Messwerte, Ort, Dauer oder MQTT-Nachrichten: mit einer Benachrichtigung, einer Markierung oder dem Ende der Aufnahme." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتفاعل القواعد أثناء التسجيل مع القيم المقاسة أو الموقع أو المدة أو رسائل MQTT: بإشعار أو علامة أو إنهاء التسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pravidla reagují během záznamu na naměřené hodnoty, polohu, délku nebo zprávy MQTT: oznámením, značkou nebo ukončením záznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regler reagerer under en optagelse på målinger, sted, varighed eller MQTT-beskeder: med en notifikation, en markering eller afslutning af optagelsen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι κανόνες αντιδρούν κατά τη διάρκεια μιας εγγραφής σε τιμές μέτρησης, τοποθεσία, διάρκεια ή μηνύματα MQTT: με ειδοποίηση, σήμανση ή λήξη της εγγραφής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rules react to readings, location, duration or MQTT messages during a recording: with a notification, an annotation or by ending the recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las reglas reaccionan durante una grabación a valores medidos, ubicación, duración o mensajes MQTT: con una notificación, una marca o el final de la grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Säännöt reagoivat tallenteen aikana mittausarvoihin, sijaintiin, kestoon tai MQTT-viesteihin: ilmoituksella, merkinnällä tai tallenteen päättämisellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les règles réagissent pendant un enregistrement aux mesures, au lieu, à la durée ou aux messages MQTT : par une notification, un repère ou la fin de l’enregistrement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pravila reagiraju tijekom snimanja na mjerne vrijednosti, lokaciju, trajanje ili MQTT poruke: obavijesti, oznakom ili završetkom snimanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A szabályok felvétel közben reagálnak a mérési értékekre, a helyre, az időtartamra vagy az MQTT-üzenetekre: értesítéssel, jelöléssel vagy a felvétel befejezésével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le regole reagiscono durante una registrazione a misure, posizione, durata o messaggi MQTT: con una notifica, un marcatore o la fine della registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ルールは、記録中の測定値、場所、経過時間、MQTT メッセージに反応して、通知、マーカー、記録の終了を実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "규칙은 기록 중에 측정값, 위치, 시간, MQTT 메시지에 반응해요. 알림을 보내거나 마커를 추가하거나 기록을 끝낼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regler reagerer under et opptak på måleverdier, sted, varighet eller MQTT-meldinger: med et varsel, en markering eller ved å avslutte opptaket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regels reageren tijdens een opname op metingen, locatie, duur of MQTT-berichten: met een melding, een markering of het einde van de opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reguły reagują podczas nagrania na pomiary, lokalizację, czas trwania lub wiadomości MQTT: powiadomieniem, znacznikiem albo zakończeniem nagrania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As regras reagem durante uma gravação a medições, localização, duração ou mensagens MQTT: com uma notificação, uma marcação ou o fim da gravação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As regras reagem durante uma gravação a medições, local, duração ou mensagens MQTT: com uma notificação, uma marcação ou o fim da gravação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regulile reacționează în timpul unei înregistrări la valori măsurate, locație, durată sau mesaje MQTT: cu o notificare, un marcaj sau încheierea înregistrării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Правила реагируют во время записи на измеренные значения, геопозицию, длительность или сообщения MQTT: уведомлением, меткой или завершением записи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pravidlá počas záznamu reagujú na namerané hodnoty, polohu, trvanie alebo správy MQTT: oznámením, značkou alebo ukončením záznamu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regler reagerar under en inspelning på mätvärden, plats, längd eller MQTT-meddelanden: med en avisering, en markering eller genom att avsluta inspelningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kurallar bir kayıt sırasında ölçüm değerlerine, konuma, süreye ya da MQTT iletilerine tepki verir: bir bildirimle, bir işaretle ya da kaydı bitirerek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Правила реагують під час запису на виміряні значення, місце, тривалість або повідомлення MQTT: сповіщенням, позначкою або завершенням запису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "规则在记录期间对测量值、位置、时长或 MQTT 消息作出反应：发出通知、添加标记，或结束记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "規則會在記錄期間對量測值、地點、時間長度或 MQTT 訊息做出反應：發出通知、加入標記，或結束記錄。"
          }
        }
      }
