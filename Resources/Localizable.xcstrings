    "Fernzugriff auf den Bildschirm ist offen. Nur aus dem eigenen Netz, mit starkem Passwort." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الوصول عن بُعد إلى الشاشة مفتوح. اقصره على شبكتك الخاصة مع كلمة سر قوية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vzdálený přístup k obrazovce je otevřený. Jen z vlastní sítě, se silným heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fjernadgang til skærmen er åben. Kun fra dit eget netværk og med en stærk adgangskode."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η απομακρυσμένη πρόσβαση στην οθόνη είναι ανοιχτή. Μόνο από το δικό σου δίκτυο, με ισχυρό κωδικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remote access to the screen is open. Only from your own network, with a strong password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El acceso remoto a la pantalla está abierto. Solo desde la propia red y con una contraseña segura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Etäyhteys näyttöön on avoinna. Vain omasta verkosta, vahvalla salasanalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’accès à distance à l’écran est ouvert. Uniquement depuis votre propre réseau, avec un mot de passe fort."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daljinski pristup zaslonu je otvoren. Samo iz vlastite mreže, uz jaku lozinku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A képernyő távoli elérése nyitva van. Csak a saját hálózatból, erős jelszóval."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'accesso remoto allo schermo è aperto. Solo dalla tua rete, con una password robusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "画面へのリモートアクセスが開放されています。自分のネットワークからのみ、強力なパスワードで使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "화면 원격 접근이 열려 있어요. 자신의 네트워크에서만, 강력한 비밀번호와 함께 쓰세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fjerntilgang til skjermen er åpen. Bare fra eget nettverk, med sterkt passord."
          }
        },
        "nl" : {
          "stringUnit" : {
