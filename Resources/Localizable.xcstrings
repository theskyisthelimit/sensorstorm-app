    "Alle Fotos und Clips dieses Falls werden mitgelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every photo and clip belonging to this case will be deleted with it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les photos et vidéos de ce cas seront supprimées avec lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le foto e i video di questo caso verranno eliminati con esso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fotos y vídeos de este caso se eliminarán con él."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle foto's en clips van dit geval worden mee verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as fotos e clipes deste caso serão excluídos junto com ele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この事案の写真と動画もすべて削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사례의 사진과 동영상도 함께 삭제됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此案件的所有照片與影片也會一併刪除。"
          }
        }
      }
    },
    "Alle Fälle, Fotos und Clips dieser Begehung werden entfernt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every case, photo and clip in this survey will be removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les cas, photos et vidéos de ce parcours seront supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i casi, le foto e i video di questo percorso verranno rimossi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los casos, fotos y vídeos de este recorrido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gevallen, foto's en clips van deze ronde worden verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os casos, fotos e clipes deste percurso serão removidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この巡回のすべての事案、写真、動画が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 순회의 모든 사례, 사진, 동영상이 삭제됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此巡查路線的所有案件、照片與影片都會被移除。"
          }
        }
      }
    },
    "Alle Sensordaten und das Video werden entfernt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sensor data and the video will be removed."
          }
        },
        "fr": {
