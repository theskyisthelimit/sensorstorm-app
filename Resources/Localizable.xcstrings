    "Beliebig viele Routen nebeneinander: pro Strasse, pro Auftrag, pro Tag." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي عدد من المسارات جنبًا إلى جنب: لكل شارع، لكل مهمة، لكل يوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libovolně mnoho tras vedle sebe: po ulici, po zakázce, po dni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så mange ruter side om side, du vil: per vej, per opgave, per dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσες διαδρομές θέλεις, δίπλα δίπλα: ανά δρόμο, ανά ανάθεση, ανά ημέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As many routes as you like, side by side: per street, per job, per day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantos recorridos como quieras, uno junto a otro: por calle, por encargo, por día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niin monta reittiä rinnakkain kuin haluat: katua, toimeksiantoa tai päivää kohti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autant de parcours que vous voulez, côte à côte : par rue, par mandat, par jour."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko god ruta jednu uz drugu: po ulici, po nalogu, po danu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akárhány útvonal egymás mellett: utcánként, megbízásonként, naponként."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti percorsi vuoi, affiancati: per strada, per incarico, per giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートはいくつでも並行して作れます：道路ごと、案件ごと、日ごと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로는 원하는 만큼 나란히 둘 수 있어요: 도로별, 작업별, 날짜별."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så mange ruter side om side du vil: per gate, per oppdrag, per dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoveel routes naast elkaar als je wilt: per straat, per opdracht, per dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowolnie wiele tras obok siebie: na ulicę, na zlecenie, na dzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos percursos você quiser, lado a lado: por rua, por serviço, por dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos percursos quiseres, lado a lado: por rua, por serviço, por dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oricâte trasee unul lângă altul: pe stradă, pe comandă, pe zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько угодно маршрутов рядом: по улице, по заказу, по дню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ľubovoľne veľa trás vedľa seba: na ulicu, na zákazku, na deň."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur många rutter som helst sida vid sida: per gata, per uppdrag, per dag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan yana istediğin kadar rota: sokak başına, iş başına, gün başına."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки завгодно маршрутів поруч: на вулицю, на замовлення, на день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路线可以并排任意多条：按街道、按工单、按日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路線可以並排任意多條：依街道、依委託、依日期。"
          }
        }
      }
    },
